# .github/workflows/harvest-corpus.yml
# Daily harvest of failed-run test results (JUnit XML / JSON / JSONL) from every public,
# non-archived myon-bioinformatics repository, so artifacts are captured before their
# 14-day retention expires. Opens a PR with new corpus entries; never auto-merges.
#
# Requirements:
# - Settings > Actions > General > "Allow GitHub Actions to create and approve pull requests".
# - GITHUB_TOKEN can read Actions artifacts of other *public* repositories.
name: Harvest failure corpus

on:
  schedule:
    - cron: "17 18 * * *"   # 03:17 JST daily
  workflow_dispatch:

permissions:
  contents: write
  pull-requests: write

concurrency:
  group: harvest-corpus
  cancel-in-progress: false

jobs:
  harvest:
    runs-on: ubuntu-latest
    timeout-minutes: 90
    steps:
      - uses: actions/checkout@v7.0.1
      - uses: actions/setup-python@v7.0.0
        with:
          python-version: "3.12"
      - run: python -m pip install pytest
      - name: Harvest (partial results allowed)
        id: harvest
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          python scripts/harvest_junit_corpus.py --allow-partial --per-repo 25 --report "$RUNNER_TEMP/harvest-report.json" --summary "$RUNNER_TEMP/harvest-summary.md"
      - name: Publish collection coverage
        if: always() && steps.harvest.outcome != 'skipped'
        run: |
          if [ -f "$RUNNER_TEMP/harvest-summary.md" ]; then
            cat "$RUNNER_TEMP/harvest-summary.md" >> "$GITHUB_STEP_SUMMARY"
          else
            echo "Collection unavailable; no coverage report was produced." >> "$GITHUB_STEP_SUMMARY"
            exit 1
          fi
      - name: Preserve collection report
        if: always() && steps.harvest.outcome != 'skipped'
        uses: actions/upload-artifact@v7.0.2
        with:
          name: harvest-coverage
          path: |
            ${{ runner.temp }}/harvest-report.json
            ${{ runner.temp }}/harvest-summary.md
          if-no-files-found: error
          retention-days: 14
      - name: Prepare corpus goldens
        run: |
          python scripts/patch_junit_manifest_jobs.py
          python scripts/capture_junit_corpus_goldens.py --missing-only
      - name: Validate corpus
        run: python -m pytest -q tests/test_junit_corpus_golden.py tests/test_results_corpus.py tests/test_fixture_redaction_scan.py
      - name: Open PR with new entries
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          if git diff --quiet && [ -z "$(git ls-files --others --exclude-standard tests/fixtures)" ]; then
            echo "No new corpus entries in confirmed scope; see coverage summary for unavailable repositories."
            exit 0
          fi
          branch="corpus/harvest-$(date -u +%Y%m%d)-${GITHUB_RUN_ID}"
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git switch -c "$branch"
          git add tests/fixtures
          git commit -m "失敗コーパスを自動収集 ($(date -u +%F))"
          git push origin "$branch"
          gh pr create --base main --head "$branch" \
            --title "失敗コーパスの定期収集 $(date -u +%F)" \
            --body-file "$RUNNER_TEMP/harvest-summary.md"
