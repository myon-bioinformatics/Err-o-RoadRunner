;box-sizing:border-box;font-family:var(--ui-font-mono,monospace)}.ui-imagestudio .ui-input{max-width:N%;box-sizing:border-box}.ui-is-status{margin:Npx N;font-weight:N;overflow-wrap:anywhere}.ui-imagestudio[data-error] .ui-is-status{color:var(--ui-danger)}.ui-is-board{position:relative;width:N%;max-width:Npx;overflow:hidden;line-height:N;border:thin solid var(--ui-border);touch-action:pan-y;background:conic-gradient(#fff N%,#dNdNdN N N%,#fff N N%,#dNdNdN N) N N/Npx Npx}.ui-is-board[data-capture]{touch-action:none}.ui-is-board svg{display:block;width:N%;height:auto}.ui-is-board:focus-visible{outline:medium solid var(--ui-accent);outline-offset:Npx}.ui-is-bar{display:flex;flex-wrap:wrap;align-items:center;gap:Npx Npx;margin:Npx N;padding:N;border:N}.ui-is-bar legend{padding:N N Npx}.ui-is-bar label,.ui-is-bar .ui-input{display:inline-flex;flex-wrap:wrap;align-items:center;gap:Npx;margin:N;min-width:N;max-width:N%}.ui-is-bar .ui-input{width:auto}.ui-is-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(Npx,Nfr));gap:N Npx}.ui-is-grid>*{min-width:N}.ui-is-grid input[type=number]{width:N%}.ui-imagestudio input[type=range]{width:N%;min-width:N;box-sizing:border-box}.ui-is-layers{display:flex;flex-wrap:wrap;gap:Npx;margin:Npx N}.ui-is-layers button[aria-pressed=true]{background:var(--ui-accent);color:var(--ui-bg)}.ui-imagestudio input[type=color]{width:Npx;height:Npx;padding:N}.ui-is-history{margin:Npx N;padding-left:Npx}.ui-is-history li{margin:Npx N}.ui-is-file{max-width:N%;min-width:N}.ui-imagestudio details{margin:Npx N}.ui-imagestudio details summary{cursor:pointer}}\n/* css/matrix.css */\n@layer components{.ui-matrix:has(>section:target)>section:not(:target){display:none}.ui-matrix>section{scroll-margin-top:Npx}.ui-matrix-tiles{display:grid;grid-template-columns:repeat(auto-fill,minmax(var(--ui-matrix-col,Npx),Nfr));gap:var(--ui-matrix-gap,Npx);padding:N;list-style:none}.ui-matrix-tiles li{border:Npx solid var(--ui-border);padding:var(--ui-matrix-pad,Npx);font-size:.Nrem;overflow-wrap:anywhere}.ui-matrix-tiles img{display:block;width:N%;height:auto;margin:var(--ui-matrix-pad,Npx) N;background:#fff}.ui-matrix-tiles .is-missing{border-style:dashed;color:var(--ui-muted)}.ui-matrix-tiles .is-fail{outline:Npx solid var(--ui-danger)}.ui-matrix-tiles .is-reference{outline:Npx solid var(--ui-accent)}.ui-matrix-page>nav{display:flex;flex-wrap:wrap;gap:Npx;margin:Npx N}.ui-matrix-page>nav .ui-button{white-space:nowrap;text-decoration:none}.ui-matrix a{overflow-wrap:anywhere}}\n/* css/mcp.css */\n@layer components{.ui-mcp hN{margin:Npx N Npx}.ui-mcp label{display:block;margin:Npx N Npx}.ui-mcp .ui-input{width:N%;box-sizing:border-box}.ui-mcp textarea{min-height:Npx;font-family:var(--ui-font-mono,monospace)}.ui-mcp-row{display:flex;flex-wrap:wrap;gap:Npx;margin:Npx N}.ui-mcp pre{margin:Npx N;white-space:pre-wrap;overflow-wrap:anywhere;max-height:Npx;overflow:auto}.ui-mcp code{overflow-wrap:anywhere}.ui-mcp-status{margin:Npx N;font-weight:N}.ui-mcp-kind{display:flex;flex-wrap:wrap;gap:Npx Npx;border:N;padding:N;margin:Npx N}.ui-mcp-kind label{display:inline-block;margin:N}}\n/* css/patterns.css */\n@layer components{.ui-patterns hN{margin:Npx N Npx}.ui-patterns label{display:block;margin:Npx N}.ui-patterns .ui-input{width:N%;box-sizing:border-box}.ui-patterns textarea{min-height:Npx;font-family:var(--ui-font-mono,monospace)}.ui-patterns-bar{display:flex;flex-wrap:wrap;align-items:center;gap:Npx Npx;margin:Npx N}.ui-patterns-bar label{display:inline-block;margin:N}.ui-patterns-bar .ui-input{width:auto;min-width:N;flex:N N Npx}.ui-patterns-list{margin:Npx N;padding-left:Npx;max-height:Npx;overflow:auto}.ui-patterns-list li{margin:Npx N;overflow-wrap:anywhere}.ui-patterns pre{margin:Npx N;white-space:pre-wrap;overflow-wrap:anywhere;max-height:Npx;overflow:auto}.ui-patterns-status{margin:Npx N;font-weight:N;overflow-wrap:anywhere}}\n/* css/photo.css */\n@layer components{.ui-photo hN{margin:Npx N Npx}.ui-photo-status{margin:Npx N N;font-weight:N}.ui-photo-bar{display:flex;flex-wrap:wrap;align-items:center;gap:Npx;margin:Npx N;padding:N;border:N}.ui-photo-bar legend{padding:N N Npx}.ui-photo-radio,.ui-photo-file{position:absolute;width:Npx;height:Npx;margin:-Npx;overflow:hidden;clip-path:inset(N%);white-space:nowrap;border:N}.ui-photo-choice label{display:inline-flex;align-items:center;gap:Npx;padding:Npx Npx;border:Npx solid var(--ui-border);border-radius:var(--ui-radius);cursor:pointer}.ui-photo-bar label.ui-button{cursor:pointer}.ui-photo-radio:checked+label{background:var(--ui-accent);color:var(--ui-bg)}.ui-photo-radio:focus-visible+label,.ui-photo-file:focus-visible+label{outline:Npx solid var(--ui-fg);outline-offset:Npx}.ui-photo-dot{display:inline-block;width:Npx;height:Npx;border:Npx solid var(--ui-fg);border-radius:N%;background:var(--dot)}.ui-photo-c-purple{--dot:#NeNcN}.ui-photo-c-red{--dot:#eN}.ui-photo-c-green{--dot:#NaN}.ui-photo-c-blue{--dot:#NeNeN}.ui-photo-c-amber{--dot:#fddN}.ui-photo-c-white{--dot:#ffffff}.ui-photo-c-black{--dot:#N}.ui-photo-stagewrap{margin:Npx N}.ui-photo-stage{display:block;max-width:N%;border:Npx solid var(--ui-border);border-radius:var(--ui-radius);touch-action:none;-webkit-user-select:none;user-select:none;-webkit-touch-callout:none;cursor:crosshair}.ui-photo-stage:focus-visible{outline:Npx solid var(--ui-accent);outline-offset:Npx}.ui-photo-stamps{display:flex;flex-wrap:wrap;align-items:center;gap:Npx;margin:Npx N}.ui-photo-stamps .ui-input{flex:N N Npx;min-width:N}.ui-photo [aria-pressed=<q>]{background:var(--ui-accent);color:var(--ui-bg)}.ui-photo pre{white-space:pre-wrap;overflow-wrap:anywhere}.ui-photo-live{position:absolute;width:Npx;height:Npx;margin:-Npx;overflow:hidden;clip-path:inset(N%)}.ui-photo details{margin:Npx N}.ui-photo summary{cursor:pointer;padding:Npx N}}\n/* css/playground.css */\n@layer components{.ui-play hN{margin:Npx N Npx}.ui-counter-value{font-size:Nrem;line-height:N.N;margin:Npx N;font-variant-numeric:tabular-nums}.ui-counter-orbs{min-height:Npx;font-size:Npx;line-height:N.N;margin:Npx N;overflow-wrap:anywhere}.ui-counter-bar{display:flex;flex-wrap:wrap;gap:Npx Npx;margin:Npx N;padding:N;border:N}.ui-counter-bar label{display:inline-block;margin:N}.ui-counter-actions{display:flex;flex-wrap:wrap;gap:Npx;margin:Npx N}.ui-counter-history{display:flex;flex-wrap:wrap;gap:Npx;margin:Npx N;padding:N;list-style:none}.ui-counter-actions button,.ui-counter-history button{touch-action:manipulation}.ui-counter-orbs[data-playing]{animation:ui-orb-rise Nms ease-out}@keyframes ui-orb-rise{from{opacity:.N;transform:translateY(N)}to{opacity:N;transform:translateY(-Npx)}}.ui-irony-arena{position:relative;overflow:hidden;min-height:Npx;margin:Npx N;border:Npx solid var(--ui-border);border-radius:var(--ui-radius,Npx);touch-action:pan-y}.ui-irony-card{position:absolute;left:N%;top:N%;translate:-N% -N%;transform:translate(var(--ox,Npx),var(--oy,Npx)) scale(var(--s,N));transition:transform Nms ease-out;width:min(Npx,calc(N% - Npx));margin:N;padding:Npx Npx Npx;box-sizing:border-box;border:Npx solid var(--ui-border);border-radius:var(--ui-radius,Npx);background:var(--ui-panel);color:var(--ui-fg);box-shadow:N Npx Npx rgba(N,N,N,.N)}.ui-irony-card[data-dragging]{--s:N.N;transition:none;box-shadow:N Npx Npx rgba(N,N,N,.N)}.ui-irony-handle{display:block;width:Npx;height:Npx;margin:N auto;border:N;background:none;color:inherit;font:inherit;line-height:Npx;text-align:center;cursor:grab;touch-action:none}.ui-irony-handle:focus-visible{outline:Npx solid currentColor;outline-offset:Npx}.ui-irony-text{margin:Npx N N;font-size:N.Nrem;line-height:N.N;text-align:center;user-select:text;-webkit-user-select:text;overflow-wrap:anywhere}.ui-irony-tone{margin:Npx N N;text-align:center}.ui-irony-arena[data-spawn]::after{content:<q>;position:absolute;left:N%;top:N%;width:N%;aspect-ratio:N;border:Npx solid currentColor;border-radius:N%;transform:translate(-N%,-N%);animation:ui-irony-ring Nms ease-out forwards;pointer-events:none}@keyframes ui-irony-ring{from{opacity:.N;scale:.N}to{opacity:N;scale:N}}@media(prefers-reduced-motion:reduce){.ui-counter-orbs[data-playing],.ui-irony-arena[data-spawn]::after{animation:none}.ui-irony-card{transition:none}}}\n/* css/report.css */\n@layer components{.ui-report hN{margin:Npx N Npx}.ui-report label{display:block;margin:Npx N Npx}.ui-report .ui-input{width:N%;box-sizing:border-box}.ui-report textarea{min-height:Npx;font-family:var(--ui-font-mono,monospace)}.ui-report-line{margin:Npx N;font-weight:N;overflow-wrap:anywhere}.ui-report-check{display:inline-block!important;margin:N N N Npx!important}.ui-report table{border-collapse:collapse;width:N%}.ui-report th,.ui-report td{border:Npx solid var(--ui-border);padding:Npx Npx;text-align:left;vertical-align:top;overflow-wrap:anywhere}.ui-report-status{margin:Npx N}.ui-report code{overflow-wrap:anywhere}.ui-report-more{margin:Npx N}}\n/* css/repository-diagnostics.css */\n.repo-diagnostics{box-sizing:border-box;border:Npx solid var(--ui-border,#cNcNcf);border-radius:Nrem;padding:N.Nrem;background:var(--ui-surface,#fff);color:var(--ui-text,#N)}.repo-diagnostics hN{margin:N N .Nrem;font-size:N.Nrem}.repo-diagnostics__commit{overflow-wrap:anywhere}.repo-diagnostics__measurements{display:grid;grid-template-columns:minmax(Nrem,Nfr) Nfr;gap:.Nrem Nrem;margin:Nrem N N}.repo-diagnostics__measurements dt,.repo-diagnostics__measurements dd{margin:N}.repo-diagnostics__measurements dd{font-variant-numeric:tabular-nums}@media(max-width:Nrem){.repo-diagnostics__measurements{grid-template-columns:Nfr}.repo-diagnostics__measurements dd{margin-bottom:.Nrem}}\n/* css/screens.css */\n@layer components{.ui-screens hN{margin:Npx N Npx}.ui-screens-bar{display:flex;flex-wrap:wrap;align-items:center;gap:Npx Npx;margin:Npx N}.ui-screens .ui-button,.ui-screens select,.ui-screens .ui-input{min-height:Npx;box-sizing:border-box;max-width:N%}.ui-screens-bar .ui-input{width:auto;min-width:N}@media(max-width:Npx){.ui-screens-bar{gap:Npx Npx}}.ui-screens-stage{min-width:N;margin:Npx N}.ui-screens-stage input[type=search],.ui-screens-stage #screens-field{width:N%}.ui-screens-items,.ui-screens-list,.ui-screens-checks,.ui-screens-chips,.ui-screens-links,.ui-screens-grid,.ui-screens-reorder,.ui-screens-swap,.ui-screens-animated{list-style:none;margin:Npx N;padding:N}.ui-screens-items{display:grid;gap:Npx}.ui-screens-items[data-mode=grid]{grid-template-columns:repeat(auto-fill,minmax(Npx,Nfr))}.ui-screens-item{display:grid;gap:Npx;min-height:Npx;text-decoration:none;color:inherit;overflow-wrap:anywhere}.ui-screens-emoji{font-size:Npx}.ui-screens-chips{display:flex;flex-wrap:wrap;gap:Npx}.ui-screens-grid{display:grid;grid-template-columns:repeat(N,minmax(N,Nfr));gap:Npx}.ui-screens-grid li{white-space:pre-line;text-align:center}.ui-screens-list li{display:flex;gap:Npx;align-items:center;margin:Npx N}.ui-screens-avatar{display:inline-flex;align-items:center;justify-content:center;flex:none;width:Npx;height:Npx;border-radius:N%;background:var(--ui-accent,currentColor);color:var(--ui-bg,Canvas)}.ui-screens-tabs,.ui-screens-bottom{display:flex;flex-wrap:wrap;gap:Npx;margin:Npx N}.ui-screens-tabs [aria-selected=true],.ui-screens-bottom [aria-current=page]{font-weight:N;text-decoration:underline}.ui-screens-dialog{margin:Npx N}.ui-screens code,.ui-screens-links li{overflow-wrap:anywhere}.ui-screens [data-screens-count]{display:block}.ui-screens pre{white-space:pre-wrap;overflow-wrap:anywhere;max-height:Npx;overflow:auto;font-family:var(--ui-font-mono,monospace)}.ui-screens-gallery{display:grid;grid-template-columns:repeat(auto-fill,minmax(Npx,Nfr));gap:Npx}.ui-screens-native{min-width:N}.ui-screens-native hN{margin:N N Npx}.ui-screens-swap{display:grid;grid-template-columns:repeat(N,minmax(N,Nfr));gap:Npx}.ui-screens-entry{display:flex;align-items:center;gap:Npx;margin:Npx N}.ui-screens-grip{flex:none;min-width:Npx;text-align:center;cursor:grab;touch-action:none;user-select:none}.ui-screens-name{flex:N;min-width:N;overflow-wrap:anywhere}.ui-screens-entry[data-dragging]{opacity:.N}.ui-screens-entry[data-over]{outline:thick solid var(--ui-accent,currentColor)}.ui-screens-checks li{display:flex;align-items:center;gap:Npx;min-height:Npx}.ui-screens-checks input{flex:none;width:Npx;height:Npx}.ui-screens-checks label{flex:N;min-width:N;min-height:Npx;display:flex;align-items:center}.ui-screens-status{margin:Npx N;font-weight:N;overflow-wrap:anywhere}@media (prefers-reduced-motion:no-preference){.ui-screens-entry[data-new]{animation:ui-screens-in Nms ease-out}}@keyframes ui-screens-in{from{opacity:N;transform:scaleY(N)}}}\n/* css/shelf.css */\n@layer components{.ui-shelf-radio{position:absolute;width:Npx;height:Npx;margin:-Npx;overflow:hidden;clip-path:inset(N%);white-space:nowrap;border:N}.ui-shelf-bar{display:flex;flex-wrap:wrap;gap:Npx;margin:Npx N;padding:N;border:N}.ui-shelf-bar legend{padding:N N Npx}.ui-shelf-bar label{padding:Npx Npx;border:Npx solid var(--ui-border);border-radius:var(--ui-radius);cursor:pointer}.ui-shelf-actions{display:flex;flex-wrap:wrap;gap:Npx;margin:Npx N}.ui-shelf textarea{width:N%;box-sizing:border-box}.ui-shelf-items{display:flex;flex-direction:column;gap:Npx;margin:Npx N N;padding:N;list-style:none}.ui-shelf-item{order:calc(var(--n,N) * -N);display:grid;grid-template-columns:auto auto minmax(N,Nfr);gap:Npx Npx;align-items:start;padding:Npx;border:Npx solid var(--ui-border);background:var(--ui-panel);border-radius:var(--ui-radius)}.ui-shelf-body{min-width:N}.ui-shelf-body pre{margin:N;white-space:pre-wrap;overflow-wrap:anywhere;font:inherit}.ui-shelf-body a{overflow-wrap:anywhere}.ui-shelf-body img{display:block;max-width:N%;max-height:Npx;height:auto}.ui-shelf-tools{grid-column:N/-N;display:flex;flex-wrap:wrap;gap:Npx}.ui-shelf-workbench{display:grid;gap:Npx;margin-top:Npx}.ui-shelf-workbench textarea{min-height:Npx}.ui-shelf:has(#shelf-sort-oldest:checked) .ui-shelf-item{order:var(--n,N)}.ui-shelf:has(#shelf-sort-manual:checked) .ui-shelf-item{order:var(--pos,N)}.ui-shelf:has(#shelf-kind-text:checked) .ui-shelf-item:not([data-kind=<q>]){display:none}.ui-shelf:has(#shelf-kind-url:checked) .ui-shelf-item:not([data-kind=<q>]){display:none}.ui-shelf:has(#shelf-kind-markdown:checked) .ui-shelf-item:not([data-kind=<q>]){display:none}.ui-shelf:has(#shelf-kind-image:checked) .ui-shelf-item:not([data-kind=<q>]){display:none}.ui-shelf:has(#shelf-kind-all:checked) label[for=<q>]{background:var(--ui-accent);color:var(--ui-bg)}.ui-shelf:has(#shelf-kind-all:focus-visible) label[for=<q>]{outline:Npx solid var(--ui-fg);outline-offset:Npx}.ui-shelf:has(#shelf-kind-text:checked) label[for=<q>]{background:var(--ui-accent);color:var(--ui-bg)}.ui-shelf:has(#shelf-kind-text:focus-visible) label[for=<q>]{outline:Npx solid var(--ui-fg);outline-offset:Npx}.ui-shelf:has(#shelf-kind-url:checked) label[for=<q>]{background:var(--ui-accent);color:var(--ui-bg)}.ui-shelf:has(#shelf-kind-url:focus-visible) label[for=<q>]{outline:Npx solid var(--ui-fg);outline-offset:Npx}.ui-shelf:has(#shelf-kind-markdown:checked) label[for=<q>]{background:var(--ui-accent);color:var(--ui-bg)}.ui-shelf:has(#shelf-kind-markdown:focus-visible) label[for=<q>]{outline:Npx solid var(--ui-fg);outline-offset:Npx}.ui-shelf:has(#shelf-kind-image:checked) label[for=<q>]{background:var(--ui-accent);color:var(--ui-bg)}.ui-shelf:has(#shelf-kind-image:focus-visible) label[for=<q>]{outline:Npx solid var(--ui-fg);outline-offset:Npx}.ui-shelf:has(#shelf-sort-newest:checked) label[for=<q>]{background:var(--ui-accent);color:var(--ui-bg)}.ui-shelf:has(#shelf-sort-newest:focus-visible) label[for=<q>]{outline:Npx solid var(--ui-fg);outline-offset:Npx}.ui-shelf:has(#shelf-sort-oldest:checked) label[for=<q>]{background:var(--ui-accent);color:var(--ui-bg)}.ui-shelf:has(#shelf-sort-oldest:focus-visible) label[for=<q>]{outline:Npx solid var(--ui-fg);outline-offset:Npx}.ui-shelf:has(#shelf-sort-manual:checked) label[for=<q>]{background:var(--ui-accent);color:var(--ui-bg)}.ui-shelf:has(#shelf-sort-manual:focus-visible) label[for=<q>]{outline:Npx solid var(--ui-fg);outline-offset:Npx}.ui-tempclip{margin-top:Npx}.ui-tempclip textarea{width:N%;box-sizing:border-box}.ui-tempclip-list{display:flex;flex-direction:column;gap:Npx;margin:Npx N N;padding:N;list-style:none}.ui-tempclip-list li{display:flex;align-items:center;gap:Npx;padding:Npx;border:Npx solid var(--ui-border);border-radius:var(--ui-radius)}.ui-tempclip-text{flex:N;min-width:N;max-height:Nem;overflow:hidden;white-space:pre-wrap;overflow-wrap:anywhere}}\n/* css/shell.css */\n@layer components{.ui-shell{display:grid;grid-template-columns:minmax(N,Nfr);grid-template-rows:auto minmax(N,Nfr) auto;height:Nvh;height:Ndvh;min-width:N;background:var(--ui-bg);color:var(--ui-fg)}.ui-shell-radio{position:absolute;width:Npx;height:Npx;margin:-Npx;overflow:hidden;clip-path:inset(N%);white-space:nowrap;border:N}.ui-shell-icons{position:absolute;width:N;height:N;overflow:hidden}.ui-shell svg{width:Npx;height:Npx;flex:none;fill:none;stroke:currentColor;stroke-width:N.N;stroke-linecap:round;stroke-linejoin:round}.ui-shell-header{display:flex;align-items:center;gap:Npx;min-height:Npx;padding:N Npx;background:var(--ui-panel);border-bottom:Npx solid var(--ui-border)}.ui-shell-title{flex:N;min-width:N;margin:N Npx;font-size:N.Nrem;font-weight:N;line-height:N.N;overflow-wrap:anywhere}.ui-shell-actions{display:flex;align-items:center;gap:Npx;flex:none}.ui-shell-actions .ui-input{padding:Npx;max-width:Npx}.ui-icon-button{display:inline-flex;align-items:center;justify-content:center;width:Npx;height:Npx;padding:N;border-radius:N%;flex:none;cursor:pointer}.ui-icon-button[aria-pressed=true] svg{fill:currentColor}.ui-shell-body{display:flex;min-height:N}.ui-rail{display:none;flex-direction:column;gap:Npx;width:Npx;flex:none;padding:Npx;border-right:Npx solid var(--ui-border);background:var(--ui-panel);overflow:auto}.ui-rail-item,.ui-bottom-item{display:flex;align-items:center;gap:Npx;min-height:Npx;padding:N Npx;border-radius:var(--ui-radius);cursor:pointer}.ui-rail-label,.ui-bottom-label{font-size:.Nrem}.ui-shell-main{flex:N;min-width:N;min-height:N;overflow-x:hidden;overflow-y:auto;padding:Npx;overscroll-behavior:contain}.ui-shell-main hN{margin:N N Npx;font-size:N.Nrem;font-weight:N}.ui-shell-tags{display:flex;flex-wrap:wrap;gap:Npx;margin:N N Npx}.ui-shell-cards{display:grid;gap:Npx;grid-template-columns:repeat(auto-fit,minmax(Npx,Nfr))}.ui-shell-card{display:flex;gap:Npx;margin:N;min-width:N}.ui-shell-card hN{margin:N N Npx;font-size:Nrem;font-weight:N}.ui-shell-card p{margin:N;overflow-wrap:anywhere}.ui-shell-table{width:N%;border-collapse:collapse}.ui-shell-table th,.ui-shell-table td{padding:Npx Npx;border-bottom:Npx solid var(--ui-border);text-align:left}.ui-shell-scroll{overflow-x:auto}.ui-shell-controls{display:flex;flex-wrap:wrap;align-items:center;gap:Npx}.ui-bottom-nav{display:flex;border-top:Npx solid var(--ui-border);background:var(--ui-panel)}.ui-bottom-item{flex:N;flex-direction:column;justify-content:center;gap:N;min-height:Npx;padding:Npx N;text-align:center}@media(min-width:Npx){.ui-rail{display:flex}.ui-bottom-nav{display:none}.ui-rail-item{justify-content:center;padding:N}.ui-rail-label{position:absolute;width:Npx;height:Npx;margin:-Npx;overflow:hidden;clip-path:inset(N%);white-space:nowrap}}@media(min-width:Npx){.ui-rail{width:Npx}.ui-rail-item{justify-content:flex-start;padding:N Npx}.ui-rail-label{position:static;width:auto;height:auto;margin:N;overflow:visible;clip-path:none;white-space:normal}}@media(max-height:Npx){.ui-shell{height:auto;min-height:Ndvh}.ui-shell-body{min-height:Npx}.ui-shell-main{overflow:visible}}@media(prefers-reduced-motion:reduce){.ui-shell-main{scroll-behavior:auto}}}\n/* css/stub.css */\n@layer components{\n.stub-shell{display:grid;gap:Nrem}\n/* Keep title/description and metadata side-by-side when space permits; wrap rather than compress either region. */\n.stub-header{display:flex;align-items:flex-start;justify-content:space-between;gap:Nrem;flex-wrap:wrap}\n.stub-toolbar{display:flex;gap:.Nrem;flex-wrap:wrap}\n.stub-toolbar fieldset{display:flex;gap:.Nrem;align-items:end;flex-wrap:wrap;width:N%;border:N;padding:N;margin:N}\n.stub-toolbar label{display:block}\n.stub-toolbar .ui-input{flex:N N Nrem}\n.stub-status{margin:.Nrem N N}\n.stub-meta{display:flex;gap:.Nrem;flex-wrap:wrap;margin:.Nrem N}\n/* Primary result pane + secondary evidence/history sidebar. */\n.stub-workspace{display:grid;grid-template-columns:minmax(N,Nfr) minmax(Nrem,.Nfr);gap:Nrem}\n.stub-result,.stub-evidence,.stub-history{min-width:N}\n.stub-actions{display:flex;gap:.Nrem;flex-wrap:wrap;margin-top:.Nrem;padding-top:.Nrem;border-top:Npx solid var(--ui-border)}\n.stub-endpoint{overflow-wrap:anywhere}\n@media(max-width:Npx){.stub-workspace{grid-template-columns:Nfr}.stub-header{display:block}}\n}\n/* css/studio.css */\n@layer components{.ui-studio hN{margin:Npx N Npx}.ui-studio label{display:inline-block;margin:Npx Npx Npx N}.ui-studio-bar{display:flex;flex-wrap:wrap;gap:Npx Npx;margin:Npx N;padding:N;border:N}.ui-studio-bar legend{padding:N N Npx}.ui-studio-bar label{margin:N}.ui-studio-row{display:flex;flex-wrap:wrap;align-items:center;gap:Npx;margin:Npx N}.ui-studio-row .ui-input{flex:N N Npx;min-width:N}.ui-studio textarea.ui-input{width:N%;box-sizing:border-box}.ui-beats{display:flex;flex-wrap:wrap;gap:Npx;margin:Npx N}.ui-beat{display:inline-flex;align-items:center;justify-content:center;width:Npx;height:Npx;border:Npx solid var(--ui-border);border-radius:N%}.ui-beat[data-on]{background:var(--ui-accent);color:var(--ui-bg)}.ui-studio-bars{margin:Npx N;padding-left:Npx}.ui-studio-bars li[data-error]{color:var(--ui-danger)}.ui-studio-chords{margin:Npx N;overflow-wrap:anywhere}.ui-studio-degrees{display:flex;flex-wrap:wrap;gap:Npx;margin:Npx N}}\n/* css/themes/github-like.css */\n/* GitHub-like prioritizes familiar light GitHub visual cues while remaining a generic light theme. */\n@layer theme{\nbody[data-ui-theme=<q>]{\n  --ui-bg:#ffffff;\n  --ui-panel:#fNfNfa;\n  --ui-fg:#NfN;\n  --ui-muted:#Ne;\n  --ui-border:#dNdNde;\n  --ui-accent:#Nda;\n}\nbody[data-ui-theme=<q>] .ui-panel,\nbody[data-ui-theme=<q>] .ui-card{\n  background:var(--ui-panel);\n  border-radius:.Nrem;\n  box-shadow:none;\n}\nbody[data-ui-theme=<q>] .ui-button,\nbody[data-ui-theme=<q>] .ui-input{\n  background:#ffffff;\n}\nbody[data-ui-theme=<q>] .ui-title{\n  border-bottom:Npx solid var(--ui-border);\n  padding-bottom:.Nrem;\n}\nbody[data-ui-theme=<q>] .ui-tag{\n  border-radius:Npx;\n  color:var(--ui-accent);\n}\n}\n/* css/themes/modern.css */\n@layer theme{body[data-ui-theme=<q>]{color-scheme:dark}body[data-ui-theme=<q>] .ui-title::before,body[data-ui-theme=<q>] .ui-card>hN::before{content:<q>;color:var(--ui-accent)}body[data-ui-theme=<q>] .ui-panel,body[data-ui-theme=<q>] .ui-card{background:var(--ui-panel);box-shadow:Npx Npx N rgba(N,N,N,.N)}body[data-ui-theme=<q>] .ui-tag::before{content:<q>;color:var(--ui-accent)}}\n</style></head><body data-ui-theme=<q>><main class=<q>><section class=<q> id=<q> data-ui-mcp><hN>MCP lab</hN><p class=<q>>In-page MCP server; nothing is sent. Legacy N-N-N protocol (initialize and Mcp-Session-Id) and the current N-N-N one (server/discover and per-request _meta).</p><p class=<q> role=<q> aria-live=<q> data-mcp-sessions></p><hN>Send a request</hN><p class=<q>>Pick a template, change what you like, send. Legacy requests after initialize need the session id (the template fills the last one).</p><div class=<q>><button class=<q> type=<q> data-mcp-template=<q>>initialize</button> <button class=<q> type=<q> data-mcp-template=<q>>notifications/initialized</button> <button class=<q> type=<q> data-mcp-template=<q>>tools/list</button> <button class=<q> type=<q> data-mcp-template=<q>>tools/call (echo)</button> <button class=<q> type=<q> data-mcp-template=<q>>server/discover (N-N-N)</button> <button class=<q> type=<q> data-mcp-template=<q>>tools/call (N-N-N)</button> </div><label id=<q> for=<q>>Method</label><select class=<q> id=<q> data-mcp-method><option>POST</option><option>GET</option></select><label for=<q>>Path</label><input class=<q> id=<q> data-mcp-path value=<q> autocomplete=<q>><label for=<q>>Headers (name: value, one per line)</label><textarea class=<q> id=<q> data-mcp-headers spellcheck=<q> rows=<q>></textarea><label for=<q>>Body</label><textarea class=<q> id=<q> data-mcp-body spellcheck=<q> rows=<q>></textarea><p><button class=<q> type=<q> data-mcp-send>Send</button> <button class=<q> type=<q> data-mcp-reset>Reset the server</button></p><p class=<q> role=<q> aria-live=<q> data-mcp-http-status>Nothing sent yet.</p><pre data-mcp-out-headers></pre><pre data-mcp-out-body></pre><hN>Run a demo</hN><label for=<q>>Text to echo</label><input class=<q> id=<q> data-mcp-demo-text value=<q> autocomplete=<q>><p><button class=<q> type=<q> data-mcp-demo-legacy>Legacy echo demo</button> <button class=<q> type=<q> data-mcp-demo-modern>Current echo demo</button></p><p class=<q> role=<q> aria-live=<q> data-mcp-demo-status></p><ol data-mcp-demo-log></ol><hN>Header names</hN><p class=<q>>A name that is not plain printable ASCII travels as <code>=?baseN?...?=</code>.</p><label for=<q>>Name</label><input class=<q> id=<q> data-mcp-codec-in value=<q> autocomplete=<q>><pre data-mcp-codec-out></pre><hN>PKCE (RFC N, SN)</hN><label for=<q>>Code verifier</label><input class=<q> id=<q> data-mcp-verifier value=<q> autocomplete=<q> spellcheck=<q>><p>Challenge: <code data-mcp-challenge></code></p><p class=<q>>The value above is the verifier of the RFC\<q>input[name=<q>]\<q>input[name=<q>]\<q>, <q>: <q>s catalogue, and the references behind its data-processing patterns.</p><label for=<q>>Search (id, title or theme)</label><input class=<q> id=<q> data-patterns-query type=<q> autocomplete=<q> placeholder=<q>><div class=<q>><span role=<q> aria-live=<q> data-patterns-count></span><button class=<q> type=<q> data-patterns-more>Show more</button></div><div class=<q>><label for=<q>>Category</label><select class=<q> id=<q> data-patterns-category><option value=<q>>All four</option><option value=<q>>A · ナビゲーション画面遷移</option><option value=<q>>B · API連携</option><option value=<q>>C · UI/テーマ</option><option value=<q>>D · データ処理</option></select><label for=<q>>Reference</label><select class=<q> id=<q> data-patterns-family><option value=<q>>Any</option><option value=<q>>collection</option><option value=<q>>concurrency</option><option value=<q>>contract</option><option value=<q>>convert</option><option value=<q>>event_loop</option><option value=<q>>future</option><option value=<q>>interaction</option><option value=<q>>native</option><option value=<q>>order</option><option value=<q>>page</option><option value=<q>>query</option><option value=<q>>reduce</option><option value=<q>>score</option><option value=<q>>screen</option><option value=<q>>search</option><option value=<q>>select</option><option value=<q>>stream</option><option value=<q>>structure</option><option value=<q>>text</option><option value=<q>>transform</option><option value=<q>>validate</option><option value=<q>>window</option><option value=<q>>workflow</option></select></div><ol class=<q> data-patterns-list></ol><p><a href=<q>>Local authentication mock (loopback server)</a></p><hN id=<q>>Run a reference</hN><label for=<q>>Family</label><select class=<q> id=<q> data-patterns-run-family><option value=<q>>collection</option><option value=<q>>concurrency</option><option value=<q>>contract</option><option value=<q>>convert</option><option value=<q>>event_loop</option><option value=<q>>future</option><option value=<q>>interaction</option><option value=<q>>native</option><option value=<q>>order</option><option value=<q>>page</option><option value=<q> selected>query</option><option value=<q>>reduce</option><option value=<q>>score</option><option value=<q>>screen</option><option value=<q>>search</option><option value=<q>>select</option><option value=<q>>stream</option><option value=<q>>structure</option><option value=<q>>text</option><option value=<q>>transform</option><option value=<q>>validate</option><option value=<q>>window</option><option value=<q>>workflow</option></select><label for=<q>>Request (JSON)</label><textarea class=<q> id=<q> data-patterns-request spellcheck=<q> rows=<q>></textarea><div class=<q>><button class=<q> type=<q> data-patterns-run>Run</button> <button class=<q> type=<q> data-patterns-example>Example</button></div><p class=<q> role=<q> aria-live=<q> data-patterns-status></p><pre data-patterns-result></pre><p class=<q>>N families run in this page. Contract, convert, search and validate stay in Python: the page shows what Python answers to their example (<code>pythonN web_ui.py --pattern-serve</code> serves this page with a bridge that runs them).</p></section></main><script type=<q>>/* web-ui patterns: the pattern references of flutter_navigation_basic in the page (query, page, score\<q>s Unicode case folding, int parsing and urlsplit. JSON cannot tell N from N.N here: an integral number is an int, so a float written N.N reads as N. */\nconst SHA_K=new UintNArray([Nx<addr>,Nx<addr>,Nx<addr>,Nx<addr>,Nx<addr>,Nx<addr>,Nx<addr>,Nx<addr>,Nx<addr>,Nx<addr>,Nx<addr>,Nx<addr>,Nx<addr>,Nx<addr>,Nx<addr>,Nx<addr>,\n Nx<addr>,Nx<addr>,Nx<addr>,Nx<addr>,Nx<addr>,Nx<addr>,Nx<addr>,Nx<addr>,Nx<addr>,Nx<addr>,Nx<addr>,Nx<addr>,Nx<addr>,Nx<addr>,Nx<addr>,Nx<addr>,\n Nx<addr>,Nx<addr>,Nx<addr>,Nx<addr>,Nx<addr>,Nx<addr>,Nx<addr>,Nx<addr>,Nx<addr>,Nx<addr>,Nx<addr>,Nx<addr>,Nx<addr>,Nx<addr>,Nx<addr>,Nx<addr>,\n Nx<addr>,Nx<addr>,Nx<addr>,Nx<addr>,Nx<addr>,Nx<addr>,Nx<addr>,Nx<addr>,Nx<addr>,Nx<addr>,Nx<addr>,Nx<addr>,Nx<addr>,Nx<addr>,Nx<addr>,Nx<addr>]);\nexport function shaNBytes(input){const data=typeof input===<q>?new TextEncoder().encode(input):input,len=data.length,padded=new UintNArray(((len+N+N)>>N)<<N);\n padded.set(data);padded[len]=NxN;const view=new DataView(padded.buffer),bits=len*N;view.setUintN(padded.length-N,Math.floor(bits/N));view.setUintN(padded.length-N,bits>>>N);\n const H=new UintNArray([Nx<addr>,Nx<addr>,Nx<addr>,Nx<addr>,Nx<addr>,Nx<addr>,Nx<addr>,Nx<addr>]),W=new UintNArray(N),rotr=(x,n)=>(x>>>n)|(x<<(N-n));\n for(let off=N;off<padded.length;off+=N){for(let i=N;i<N;i++)W[i]=view.getUintN(off+i*N);\n  for(let i=N;i<N;i++){const a=W[i-N],b=W[i-N],sN=rotr(a,N)^rotr(a,N)^(a>>>N),sN=rotr(b,N)^rotr(b,N)^(b>>>N);W[i]=(W[i-N]+sN+W[i-N]+sN)>>>N}\n  let a=H[N],b=H[N],c=H[N],d=H[N],e=H[N],f=H[N],g=H[N],h=H[N];\n  for(let i=N;i<N;i++){const SN=rotr(e,N)^rotr(e,N)^rotr(e,N),ch=(e&f)^(~e&g),tN=(h+SN+ch+SHA_K[i]+W[i])>>>N,SN=rotr(a,N)^rotr(a,N)^rotr(a,N),maj=(a&b)^(a&c)^(b&c),tN=(SN+maj)>>>N;\n   h=g;g=f;f=e;e=(d+tN)>>>N;d=c;c=b;b=a;a=(tN+tN)>>>N}\n  H[N]+=a;H[N]+=b;H[N]+=c;H[N]+=d;H[N]+=e;H[N]+=f;H[N]+=g;H[N]+=h}\n const out=new UintNArray(N),o=new DataView(out.buffer);H.forEach((x,i)=>o.setUintN(i*N,x));return out}\nexport const shaNHex=input=>Array.from(shaNBytes(input),x=>x.toString(N).padStart(N,<q>)).join(<q>);\nconst SPACE=<q>;\nexport const pyStrip=s=>s.replace(new RegExp(<q>+SPACE+<q>+SPACE+<q>,<q>),<q>);\nexport const PATTERN_CATEGORIES=[[<q>,<q>,<q>],[<q>,<q>,<q>],[<q>,<q>,<q>],[<q>,<q>,<q>]];\nexport const PATTERN_THEMES={<q>:[[N,N,<q>],[N,N,<q>],[N,N,<q>],[N,N,<q>],[N,N,<q>],[N,N,<q>],[N,N,<q>],[N,N,<q>],[N,N,<q>],[N,N,<q>]],<q>:[[N,N,<q>],[N,N,<q>],[N,N,<q>],[N,N,<q>],[N,N,<q>],[N,N,<q>],[N,N,<q>],[N,N,<q>]],<q>:[[N,N,<q>],[N,N,<q>],[N,N,<q>],[N,N,<q>],[N,N,<q>],[N,N,<q>],[N,N,<q>],[N,N,<q>]],<q>:[[N,N,<q>],[N,N,<q>],[N,N,<q>],[N,N,<q>],[N,N,<q>],[N,N,<q>],[N,N,<q>],[N,N,<q>]]};\nexport const PATTERN_TITLES={<q>:<q>,<q>:<q>,<q>:<q>,<q>:<q>};\nexport const PATTERN_PRODUCERS=[[[N,N,N,N,N,N,N,N,N,N,N,N,N,N,N,N,N,N,N,N,N,N,N,N,N,N,N],<q>,<q>],[[N,N,N,N,N,N],<q>,<q>],[[N,N,N,N,N,N,N,N,N],<q>,<q>],[[N,N],<q>,<q>],[[N,N],<q>,<q>],[[N,N,N,N,N,N],<q>,<q>],[[N,N,N,N,N,N,N],<q>,<q>],[[N,N,N],<q>,<q>],[[N,N,N,N,N,N],<q>,<q>],[[N,N,N,N,N,N],<q>,<q>],[[N,N,N,N],<q>,<q>],[[N,N,N,N,N,N,N,N,N,N,N],<q>,<q>],[[