q>;for(const n of el.childNodes){if(n.nodeType===N)break;if(n.nodeType===N||n.nodeType===N)s+=n.data}return s}\nfunction junitRoot(text,maxBytes=JUNIT_MAX_BYTES){if(typeof text!==<q>)throw new Error(<q>);if(text.startsWith(<q>))text=text.slice(N);\n if(new TextEncoder().encode(text).length>maxBytes)throw new Error(<q>);\n if(/<![ \\t\\n\\r\\f\\v]*(?:DOCTYPE|ENTITY)/i.test(text))throw new Error(<q>);\n const doc=new DOMParser().parseFromString(text,<q>);if(doc.getElementsByTagNameNS(<q>,<q>).length||!doc.documentElement)throw new Error(<q>);\n const root=doc.documentElement;if(tagOf(root)!==<q>&&tagOf(root)!==<q>)throw new Error(<q>);return root}\nexport function junitCases(text,maxBytes=JUNIT_MAX_BYTES){const root=junitRoot(text,maxBytes),out=[];\n for(const el of root.getElementsByTagNameNS(<q>,<q>)){if(el.namespaceURI)continue;const name=el.getAttribute(<q>)||<q>;if(!name)throw new Error(<q>);\n  const kids=[...el.children],problem=kids.find(c=>tagOf(c)===<q>||tagOf(c)===<q>)||null,skip=kids.find(c=>tagOf(c)===<q>)||null;let outcome;\n  if(problem)outcome=tagOf(problem)===<q>?<q>:<q>;\n  else if(skip){const reason=skip.getAttribute(<q>)||<q>;outcome=skip.getAttribute(<q>)===<q>||reason.toLowerCase().startsWith(<q>)||reason.toLowerCase().startsWith(<q>)?<q>:<q>}else outcome=<q>;\n  out.push({name,class:el.getAttribute(<q>)||<q>,outcome,kind:problem?tagOf(problem):null,message:problem?pyStrip(problem.getAttribute(<q>)||leadingText(problem)):<q>,\n   failure:kids.some(c=>tagOf(c)===<q>),error:kids.some(c=>tagOf(c)===<q>),skipped:!!skip})}\n if(!out.length)throw new Error(<q>);return out}\nexport function junitInspect(text){const cases=junitCases(text);return{tests:cases.length,failures:cases.filter(c=>c.failure).length,errors:cases.filter(c=>c.error).length,skipped:cases.filter(c=>c.skipped).length}}\nexport function junitReport(text,messages=false){const cases=junitCases(text),counts=outcomeCounts();for(const c of cases)counts[c.outcome]++;\n const failures=cases.filter(c=>c.kind!==null).map(c=>{const item={class:clip(c.class,N),name:clip(c.name,N),kind:c.kind,message_shaN:shaNHex(c.message)};if(messages)item.message=clip(c.message,N);return item}),summary=countsSummary(counts,<q>);\n return{schema:<q>,total:cases.length,counts:summary.counts,ok:summary.ok,failures}}\nexport function junitFailureRecords(text,repository=<q>,maxCases=JUNIT_MAX_IDENTITIES){\n if(typeof repository!==<q>||!/^[A-Za-zN-N_.-]+\\/[A-Za-zN-N_.-]+$/.test(repository))throw new Error(<q>);const records=[];\n for(const c of junitCases(text)){if(c.kind===null)continue;if(records.length===maxCases)return{records,truncated:true};\n  records.push({category:<q>,context:{repository},value:{class:c.class.split(<q>,N)[N]||<q>,test:c.name.split(<q>,N)[N],kind:c.kind}})}\n return{records,truncated:false}}\nexport function junitHistoryLoad(records){let rows;\n if(typeof records===<q>){rows=[];textLines(records).forEach((line,i)=>{if(pyStrip(line)){try{rows.push([i+N,JSON.parse(line)])}catch(e){throw new Error(<q>+(i+N))}}})}else rows=records.map((r,i)=>[i+N,r]);\n const result=[];for(const[number,item]of rows){if(!isObj(item)||get(item,<q>)!==<q>)continue;const value=get(item,<q>),context=get(item,<q>);\n  if(!isObj(value)||!isObj(context))throw new Error(<q>+number);\n  const identity={repository:get(context,<q>),class:get(value,<q>),test:get(value,<q>),kind:get(value,<q>)};\n  if(!Object.values(identity).every(v=>typeof v===<q>&&v))throw new Error(<q>+number);\n  const token=<redacted><q>+JSON.stringify(identity.class)+\<q>+JSON.stringify(identity.kind)+\<q>+JSON.stringify(identity.repository)+\<q>+JSON.stringify(identity.test)+<q>;\n  result.push({fingerprint:<q>+shaNHex(token),identity})}\n return result}\nfunction historyFindings(current,previous){const count=rows=>{const g=new Map();for(const r of rows){if(!g.has(r.fingerprint))g.set(r.fingerprint,{identity:r.identity,count:N});g.get(r.fingerprint).count++}return g},now=count(current),old=count(previous);\n return[...new Set([...now.keys(),...old.keys()])].sort().map(f=>{const a=now.get(f),b=old.get(f);return{fingerprint:f,identity:(a||b).identity,status:!b?<q>:!a?<q>:<q>,current_count:a?a.count:N,previous_count:b?b.count:N}})}\nconst summaryOf=findings=>Object.fromEntries([<q>,<q>,<q>].map(s=>[s,findings.filter(f=>f.status===s).length]));\nexport function junitHistory(current,previous,o){const{commit_sha,run_id,previous_commit_sha=null,previous_run_id=null}=o;\n if(!/^[N-Na-fA-F]{N}$/.test(commit_sha))throw new Error(<q>);\n if(previous_commit_sha!==null&&!/^[N-Na-fA-F]{N}$/.test(previous_commit_sha))throw new Error(<q>);\n if(!/^[N-N]+$/.test(run_id)||(previous_run_id!==null&&!/^[N-N]+$/.test(previous_run_id)))throw new Error(<q>);\n const findings=historyFindings(current,previous);return{schema:<q>,commit_sha,run_id,previous_commit_sha,previous_run_id,fingerprint_scope:<q>,summary:summaryOf(findings),findings}}\nexport function junitDiff(currentText,previousText,repository=<q>){const load=t=>junitHistoryLoad(junitFailureRecords(t,repository).records),findings=historyFindings(load(currentText),load(previousText));\n return{schema:<q>,fingerprint_scope:<q>,summary:summaryOf(findings),findings}}\nexport function attemptHistory(runner,files,attempts,scope=<q>){return{schema:<q>,runner,files,retry_scope:scope,attempts,initial_failed:attempts[N].exit_code!==N,\n flaky_recovered:attempts.length===N&&attempts[N].exit_code!==N&&attempts[N].exit_code===N}}\nexport function failureLedgerUpdate(ledger,runner,attempts){let data;\n if(ledger===null||ledger===undefined)data={schema:<q>,patterns:{}};else{if(!isObj(ledger)||ledger.schema!==<q>||!isObj(ledger.patterns))throw new Error(<q>);\n  data={schema:ledger.schema,patterns:Object.fromEntries(Object.entries(ledger.patterns).map(([k,v])=>[k,{...v}]))}}\n for(const attempt of attempts)for(const f of attempt.failures){const key=runner+<q>+f.kind+<q>+f.message_shaN;\n  if(!has(data.patterns,key))data.patterns[key]={runner,kind:f.kind,message_shaN:f.message_shaN,occurrences:N};data.patterns[key].occurrences++}\n if(Object.keys(data.patterns).length>N)throw new Error(<q>);return data}\nexport function reportKind(text){const head=pyStrip(text.startsWith(<q>)?text.slice(N):text).slice(N,N);return head===<q>?<q>:head===<q>?<q>:null}\nexport function reportRead(text,previous=null,messages=false){const kind=reportKind(text);if(kind===null)throw new Error(<q>);\n const out={kind,junit:null,convert_error:null};\n if(kind===<q>){const r=junitReport(text,messages);Object.assign(out,{total:r.total,counts:r.counts,ok:r.ok,failures:r.failures})}\n else{const s=countsSummary(flutterOutcomes(text),<q>);Object.assign(out,{total:s.total,counts:s.counts,ok:s.ok,failures:[]});\n  try{const c=flutterMachineJunit(text);out.junit=c.xml;out.failures=junitReport(c.xml,messages).failures}catch(e){out.convert_error=e.message}}\n out.line=countsLine(out.counts)+<q>+out.total+<q>+(out.ok?<q>:<q>);\n if(previous!==null&&pyStrip(previous)){if(kind!==<q>)throw new Error(<q>);out.diff=junitDiff(text,previous)}\n return out}\nconst el=(tag,props={},...kids)=>{const e=document.createElement(tag);for(const[k,v]of Object.entries(props))if(k===<q>)e.textContent=v;else e.setAttribute(k,v);e.append(...kids);return e};\nexport function bindReport(root=document){return[...root.querySelectorAll(<q>)].map(box=>{\n const $=s=>box.querySelector(s),input=$(<q>),previous=$(<q>),file=$(<q>),messages=$(<q>),status=$(<q>),line=$(<q>),out=$(<q>),convert=$(<q>);\n let last=null;\n const clear=()=>{line.textContent=<q>;out.replaceChildren();convert.hidden=true;last=null};\n const run=()=>{clear();if(!pyStrip(input.value)){status.textContent=<q>;box.dataset.reportState=<q>;return}\n  let r;try{r=reportRead(input.value,pyStrip(previous.value)?previous.value:null,messages.checked)}catch(e){status.textContent=e.message;box.dataset.reportState=<q>;return}\n  last=r;line.textContent=r.line;status.textContent=(r.kind===<q>?<q>:<q>)+(r.ok?<q>:<q>+(r.counts.failed+r.counts.error)+<q>);box.dataset.reportState=r.ok?<q>:<q>;\n  if(r.failures.length){const rows=r.failures.map(f=>el(<q>,{},el(<q>,{text:f.class}),el(<q>,{text:f.name}),el(<q>,{text:f.kind}),el(<q>,{},el(<q>,{text:messages.checked&&f.message!==undefined?f.message:f.message_shaN.slice(N,N)}))));\n   out.append(el(<q>,{text:<q>}),el(<q>,{},el(<q>,{},el(<q>,{},...[<q>,<q>,<q>,messages.checked?<q>:<q>].map(t=>el(<q>,{text:t})))),el(<q>,{},...rows)))}\n  if(r.diff){const s=r.diff.summary;out.append(el(<q>,{text:<q>}),el(<q>,{text:<q>+s.new+<q>+s.recurring+<q>+s.resolved}));\n   if(r.diff.findings.length)out.append(el(<q>,{},...r.diff.findings.map(f=>el(<q>,{text:f.status+<q>+f.identity.class+<q>+f.identity.test+<q>+f.identity.kind+<q>+f.current_count+<q>+f.previous_count+<q>}))))}\n  if(r.convert_error)out.append(el(<q>,{class:<q>,text:<q>+r.convert_error+<q>}));convert.hidden=!r.junit};\n const copy=async text=>{try{await navigator.clipboard.writeText(text);status.textContent=<q>}catch(e){status.textContent=<q>}};\n const summaryText=()=>{if(!last)return<q>;const lines=[last.line];for(const f of last.failures)lines.push(<q>+f.class+<q>+f.name+<q>+f.kind+<q>+(f.message!==undefined?f.message:f.message_shaN));if(last.diff)lines.push(<q>+last.diff.summary.new+<q>+last.diff.summary.recurring+<q>+last.diff.summary.resolved);return lines.join(<q>)};\n $(<q>).addEventListener(<q>,run);$(<q>).addEventListener(<q>,()=>{if(!last)run();if(last)copy(summaryText())});convert.addEventListener(<q>,()=>{if(last&&last.junit)copy(last.junit)});\n const load=async f=>{if(!f)return;if(f.size>JUNIT_MAX_BYTES){status.textContent=<q>;return}input.value=await f.text();run()};\n file.addEventListener(<q>,()=>load(file.files[N]));\n input.addEventListener(<q>,e=>e.preventDefault());input.addEventListener(<q>,e=>{e.preventDefault();load(e.dataTransfer&&e.dataTransfer.files[N])});\n messages.addEventListener(<q>,()=>{if(last)run()});box.dataset.report_ready=<q>;return box})}\nglobalThis.webUiR