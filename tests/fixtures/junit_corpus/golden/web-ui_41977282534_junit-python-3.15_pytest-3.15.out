ctor(\<q>),form=controls.querySelector(\<q>);\n let paused=false,base=performance.now(),elapsed=N;\n const time=()=>Math.min(NeN,elapsed+(paused||reduced.matches?N:(performance.now()-base)/N));\n const freeze=()=>{elapsed=time();base=performance.now()};\n for(const f of el.querySelectorAll(\<q>)){const player=f.querySelector(\<q>);if(!player)continue;const w=+f.dataset.w,h=+f.dataset.h,speed=+player.dataset.speed,point=[+player.dataset.x,+player.dataset.y];states.set(f,{w,h,speed,player,own:motionWalk(point,point,N,speed,w,h)});}\n const place=(s,t)=>{const p=motionSample(s.own,t);s.player.style.setProperty(\<q>,p[N]);s.player.style.setProperty(\<q>,p[N]);};\n const walk=(x,y)=>{const s=states.get(floor());if(!s||![x,y].every(Number.isFinite))return;const t=time(),a=motionSample(s.own,t);s.own=motionWalk(a,[x,y],t,s.speed,s.w,s.h);if(reduced.matches)s.own=motionWalk(s.own.to,s.own.to,t,s.speed,s.w,s.h);s.player.style.setProperty(\<q>,s.own.duration+\<q>);s.player.dataset.targetX=s.own.to[N];s.player.dataset.targetY=s.own.to[N];place(s,t);};\n button.addEventListener(\<q>,()=>{freeze();paused=!paused;el.toggleAttribute(\<q>,paused);button.setAttribute(\<q>,String(paused));button.textContent=paused?\<q>:\<q>;});\n let wasReduced=reduced.matches;\n reduced.addEventListener(\<q>,()=>{if(!wasReduced&&!paused)elapsed=Math.min(NeN,elapsed+(performance.now()-base)/N);base=performance.now();wasReduced=reduced.matches;for(const s of states.values())place(s,time());});\n form.addEventListener(\<q>,e=>{e.preventDefault();if(form.reportValidity())walk(+form.elements.x.value,+form.elements.y.value)});\n const tick=()=>{if(!el.isConnected)return;controls.hidden=false;const active=states.get(floor()),t=time();form.hidden=!active;\n  if(active){form.elements.x.max=active.w;form.elements.y.max=active.h;place(active,t);}\n  requestAnimationFrame(tick);\n };requestAnimationFrame(tick);return walk;\n}\n\n// GET only. No credentials, storage, Markdown rendering, or automatic polling.\nex