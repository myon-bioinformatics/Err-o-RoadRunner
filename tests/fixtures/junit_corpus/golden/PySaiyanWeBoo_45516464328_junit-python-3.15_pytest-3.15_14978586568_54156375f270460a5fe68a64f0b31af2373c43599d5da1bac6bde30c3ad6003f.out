ui-space)}.ui-kv dt{color:var(--ui-muted)}.ui-kv dd{margin:N}.ui-badges .ui-tag{margin-right:.Nrem}.ui-tabs{margin:var(--ui-space) N}.ui-tab-input{position:absolute;opacity:N;pointer-events:none}.ui-tab{display:inline-block;padding:.Nrem .Nrem;margin:N .Nrem .Nrem N;border:Npx solid var(--ui-border);border-radius:var(--ui-radius);cursor:pointer;color:var(--ui-muted)}.ui-tab-input:checked+.ui-tab{color:var(--ui-fg);border-color:var(--ui-accent);background:var(--ui-panel)}.ui-tab-input:focus-visible+.ui-tab{outline:Npx solid var(--ui-accent);outline-offset:Npx}.ui-tab-panel{display:none}.ui-tab-panel img{max-width:N%;height:auto}.ui-tabs&gt;.ui-tab-input:nth-of-type(N):checked~.ui-tab-panel:nth-of-type(N){display:block}.ui-tabs&gt;.ui-tab-input:nth-of-type(N):checked~.ui-tab-panel:nth-of-type(N){display:block}.ui-tabs&gt;.ui-tab-input:nth-of-type(N):checked~.ui-tab-panel:nth-of-type(N){display:block}.ui-tabs&gt;.ui-tab-input:nth-of-type(N):checked~.ui-tab-panel:nth-of-type(N){display:block}.ui-tabs&gt;.ui-tab-input:nth-of-type(N):checked~.ui-tab-panel:nth-of-type(N){display:block}.ui-tabs&gt;.ui-tab-input:nth-of-type(N):checked~.ui-tab-panel:nth-of-type(N){display:block}.ui-tabs&gt;.ui-tab-input:nth-of-type(N):checked~.ui-tab-panel:nth-of-type(N){display:block}.ui-tabs&gt;.ui-tab-input:nth-of-type(N):checked~.ui-tab-panel:nth-of-type(N){display:block}&lt;/style&gt;&lt;/head&gt;&lt;body data-ui-theme=&quot;modern&quot;&gt;&lt;main class=&quot;ui-page&quot;&gt;&lt;hN class=&quot;ui-title&quot;&gt;Run report&lt;/hN&gt;&lt;p class=&quot;ui-muted&quot;&gt;A page built from data: the consumer owns the JSON, web_ui the HTML and CSS.&lt;/p&gt;&lt;fieldset class=&quot;ui-layout-switch&quot;&gt;&lt;legend&gt;Layout&lt;/legend&gt;&lt;label&gt;&lt;input type=&quot;radio&quot; name=&quot;ui-layout&quot; value=&quot;comfortable&quot; checked&gt; Comfortable &lt;small&gt;default: Npx text, Npx spacing, Npx page&lt;/small&gt;&lt;/label&gt;&lt;label&gt;&lt;input type=&quot;radio&quot;