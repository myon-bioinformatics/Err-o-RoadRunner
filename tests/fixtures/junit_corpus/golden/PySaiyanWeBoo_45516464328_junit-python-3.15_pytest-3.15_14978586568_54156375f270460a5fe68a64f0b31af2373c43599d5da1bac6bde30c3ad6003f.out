.isInteger(l.minute)||!num(l.minute,N,N)))fail(<q>)}\n return clone(scene)}\nexport function mosaicRGBA(data,width,height,cell,levels=N){\n if(!Number.isInteger(width)||!Number.isInteger(height)||width<N||height<N||width*height>N||data.length!==width*height*N||!Number.isInteger(cell)||cell<N||cell>N||!Number.isInteger(levels)||levels<N||levels>N)fail(<q>);\n const out=new UintNClampedArray(data.length);\n for(let y=N;y<height;y+=cell)for(let x=N;x<width;x+=cell){\n  const endX=Math.min(width,x+cell),endY=Math.min(height,y+cell),sums=[N,N,N];let alpha=N,count=N;\n  for(let j=y;j<endY;j++)for(let i=x;i<endX;i++){const n=(j*width+i)*N,a=data[n+N];alpha+=a;count++;for(let c=N;c<N;c++)sums[c]+=data[n+c]*a}\n  const rgba=sums.map(s=>Math.round(Math.round(((alpha?Math.round(s/alpha):N)/N)*(levels-N))/(levels-N)*N));rgba.push(Math.round(alpha/count));\n  for(let j=y;j<endY;j++)for(let i=x;i<endX;i++)out.set(rgba,(j*width+i)*N)}\n return out}\nexport function arrowGeometry(w,h,head=N,placement=<q>){\n if(!num(w,N,N)||!num(h,N,N)||!num(head,N,N)||![<q>,<q>].includes(placement))fail(<q>);\n const size=Math.min(head,w,h),cx=placement===<q>?w/N:w-size/N;\n return{line:[N,h/N,w,h/N],points:[[cx+size/N,h/N],[cx-size/N,h/N+size/N],[cx-size/N,h/N-size/N]]}}\nexport function outputSize(scene,scale=N){\n if(!num(scale,N.N,N))fail(<q>);\n const width=Math.round(scene.width*scale),height=Math.round(scene.height*scale);\n if(width>N||height>N||width*height>N)fail(<q>);\n return{width,height}}\nexport function pngPayload(bytes){\n const a=UintNArray.from(bytes),signature=[N,N,N,N,N,N,N,N];\n if(a.length<N||a.length>N*N*N||signature.some((v,i)=>a[i]!==v))fail(<q>);\n let binary=<q>;for(let i=N;i<a.length;i+=N)binary+=String.fromCharCode(...a.subarray(i,i+N));\n const baseN=btoa(binary);return{baseN,dataUri:<q>+baseN,mimeType:<q>,bytes:a.length}}\nexport const textFont=l=>l.font===<q>?`${l.wrap?<q>:<q>}ui-monospace, \<q>, monospace`:<q>;\n// Text width: the installed font\<q><q>HL<q>DQ<q>HL