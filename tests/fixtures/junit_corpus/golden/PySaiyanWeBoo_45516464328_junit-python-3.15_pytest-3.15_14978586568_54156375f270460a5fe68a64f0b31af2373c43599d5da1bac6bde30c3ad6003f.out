t;p class=&quot;ui-badges&quot;&gt;&lt;span class=&quot;ui-tag&quot;&gt;chromium&lt;/span&gt; &lt;span class=&quot;ui-tag ui-pass&quot;&gt;N pass&lt;/span&gt; &lt;span class=&quot;ui-tag ui-fail&quot;&gt;N fail&lt;/span&gt;&lt;/p&gt;&lt;dl class=&quot;ui-kv&quot;&gt;&lt;dt&gt;commit&lt;/dt&gt;&lt;dd&gt;abcN&lt;/dd&gt;&lt;dt&gt;recorded&lt;/dt&gt;&lt;dd&gt;N-N-N&lt;/dd&gt;&lt;/dl&gt;&lt;table class=&quot;ui-table&quot;&gt;&lt;caption&gt;per environment&lt;/caption&gt;&lt;thead&gt;&lt;tr&gt;&lt;th scope=&quot;col&quot;&gt;environment&lt;/th&gt;&lt;th scope=&quot;col&quot;&gt;verdict&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td&gt;Linux-chromium-desktop&lt;/td&gt;&lt;td&gt;pass&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Linux-chromium-pixel&lt;/td&gt;&lt;td&gt;fail&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;section class=&quot;ui-panel&quot;&gt;&lt;hN&gt;Detail&lt;/hN&gt;&lt;p class=&quot;ui-muted&quot;&gt;Two paragraphs,&lt;/p&gt;&lt;p class=&quot;ui-muted&quot;&gt;separated by a blank line.&lt;/p&gt;&lt;pre class=&quot;ui-output&quot;&gt;$ run\nok&lt;/pre&gt;&lt;p class=&quot;ui-links&quot;&gt;&lt;a href=&quot;./receipt.json&quot;&gt;receipt&lt;/a&gt;&lt;/p&gt;&lt;/section&gt;&lt;div class=&quot;ui-tabs&quot; data-ui-tabs&gt;&lt;input type=&quot;radio&quot; class=&quot;ui-tab-input&quot; name=&quot;ui-tabs-NaffeN&quot; id=&quot;ui-tabs-NaffeN-N&quot; checked&gt;&lt;label class=&quot;ui-tab&quot; for=&quot;ui-tabs-NaffeN-N&quot;&gt;🎞 Demo&lt;/label&gt;&lt;input type=&quot;radio&quot; class=&quot;ui-tab-input&quot; name=&quot;ui-tabs-NaffeN&quot; id=&quot;ui-tabs-NaffeN-N&quot;&gt;&lt;label class=&quot;ui-tab&quot; for=&quot;ui-tabs-NaffeN-N&quot;&gt;🧩 Features&lt;/label&gt;&lt;div class=&quot;ui-tab-panel&quot;&gt;&lt;p&gt;A GIF or image goes here.&lt;/p&gt;&lt;/div&gt;&lt;div class=&quot;ui-tab-panel&quot;&gt;&lt;table class=&quot;ui-table&quot;&gt;&lt;thead&gt;&lt;tr&gt;&lt;th scope=&quot;col&quot;&gt;feature&lt;/th&gt;&lt;th scope=&quot;col&quot;&gt;how&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td&gt;report&lt;/td&gt;&lt;td&gt;one page from JSON&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;/div&gt;&lt;/main&gt;&lt;/body&gt;&lt;/html&gt;\n<q>ui-parts-frame<q>theme-terminal<q>terminal<q>allow-same-origin<q>lazy<q>&lt;!doctype html&gt;\n&lt;html lang=&quot;en&quot;&gt;&lt;head&gt;&lt;meta charset=&quot;utf-N&quot;&gt;&lt;meta name=&quot;viewport&quot; content=&quot;width=device-width,initial-scale=N&quot;&gt;&lt;meta name=&quot;generator&quot; content=&quot;web_ui checkout&quot;&gt;&lt;title&gt;Run report&lt;/title&gt;&lt;style&gt;@layer base,components,theme;\n/* css/tokens.css */\n:root{--ui-bg:#NdN;--ui-panel:#N;--ui-fg:#dNfNcN;--ui-muted:#NbNe;--ui-border:#NaNff;--ui-accent:#NeeN;--ui-danger:#cfNe;--ui-radius:N;--ui-text:Npx;--ui-space:Nrem;--ui-max:Npx;--ui-font:Meiryo,メイリオ,sans-serif;--ui-font-mono:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,&quot;Liberation Mono&quot;,&quot;Courier New&quot;,monospace}\n/* auto: dark (the :root palette) unless the browser prefers light, then the github-like palette. */\nbody[data-ui-theme=&quot;auto&quot;]{color-scheme:dark light}@media(prefers-color-scheme:light){body[data-ui-theme=&quot;auto&quot;]{--ui-bg:#ffffff;--ui-panel:#fNfNfa;--ui-fg:#NfN;--ui-muted:#Ne;--ui-border:#dNdNde;--ui-accent:#Nda}}\n/* Candidate themes, token-only: palettes, no theme files (see theme_palettes()). */\nbody[data-ui-theme=&quot;green&quot;]{--ui-bg:#edfNec;--ui-panel:#ffffff;--ui-fg:#NbNb;--ui-muted:#NaN;--ui-border:#ccdcdN;--ui-accent:#NdN;--ui-danger:#aN;--ui-radius:.Nrem;color-scheme:light}\nbody[data-ui-theme=&quot;red&quot;]{--ui-bg:#fNeeee;--ui-panel:#fdfcfc;--ui-fg:#NcN;--ui-muted:#NeN;--ui-border:#dNbfbf;--ui-accent:#cN;--ui-danger:#dN;--ui-radius:.Nrem;color-scheme:light}\nbody[data-ui-theme=&quot;blue&quot;]{--ui-bg:#eefNfN;--ui-panel:#fcfcfd;--ui-fg:#Nc;--ui-muted:#NeNe;--ui-border:#bfcNdN;--ui-accent:#NccN;--ui-danger:#dN;--ui-radius:.Nrem;color-scheme:light}\nbody[data-ui-theme=&quot;purple&quot;]{--ui-bg:#fffbfe;--ui-panel:#fNfNfa;--ui-fg:#NcNbNf;--ui-muted:#Nf;--ui-border:#cacNdN;--ui-accent:#NaN;--ui-danger:#bNe;--ui-radius:.Nrem;color-scheme:light}\nbody[data-ui-theme=&quot;terminal&quot;]{--ui-bg:#NaNeN;--ui-panel:#Na;--ui-fg:#dNdeeN;--ui-muted:#NcNaNd;--ui-border:#NbN;--ui-accent:#NfdNaN;--ui-danger:#ffN;--ui-radius:N;--ui-font:var(--ui-font-mono);color-scheme:dark}\n/* css/base.css */\n@layer base{*{box-sizing:border-box}body{margin:N;background:var(--ui-bg);color:var(--ui-fg);font:var(--ui-text)/N.N var(--ui-font)}pre,code,kbd,samp{font-family:var(--ui-font-mono)!important}.ui-page{max-width:var(--ui-max);margin:auto;padding:var(--ui-space)}.ui-title{overflow-wrap:anywhere}a{color:inherit}.ui-print-only{display:none}@media print{body{background:#fff;color:#N}.ui-page{max-width:none;padding:N}.ui-no-print{display:none}.ui-print-only{display:block}a{text-decoration:none}}@media(prefers-reduced-motion:reduce){*,::before,::after{animation-duration:.Nms!important;animation-iteration-count:N!important;transition-duration:.Nms!important;scroll-behavior:auto!important}}}\n/* css/components.css */\n@layer components{.ui-panel,.ui-card{background:var(--ui-panel);border:Npx solid var(--ui-border);padding:var(--ui-space);margin:var(--ui-space) N;border-radius:var(--ui-radius)}.ui-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(Npx,Nfr));gap:.Nrem}.ui-tag{display:inline-block;border:Npx solid var(--ui-border);padding:.Nrem .Nrem}.ui-button,.ui-input,.ui-elements button,.ui-elements select,.ui-elements textarea,.ui-elements input:not([type=checkbox],[type=radio],[type=range],[type=color],[type=file]){font:inherit;background:var(--ui-panel);color:var(--ui-fg);border:Npx solid var(--ui-border);padding:.Nrem;border-radius:var(--ui-radius)}.ui-button,.ui-elements button{cursor:pointer}.ui-button:hover,.ui-elements button:hover{border-color:var(--ui-accent)}.ui-button:disabled,.ui-elements button:disabled{opacity:.N;cursor:default}.ui-elements input[type=range],.ui-elements input[type=checkbox],.ui-elements input[type=radio]{accent-color:var(--ui-accent)}.ui-elements label{color:var(--ui-muted)}.ui-muted{color:var(--ui-muted)}.ui-back{margin:N N Npx;font-size:.Nrem}.ui-back .ui-links{margin:N}.ui-back a{color:var(--ui-muted);text-decoration:none}.ui-back a:hover,.ui-back a:focus-visible{color:var(--ui-accent);text-decoration:underline}.ui-output{font:inherit;white-space:pre-wrap;overflow:auto;background:#dNdeeN;color:#NbN;border:Npx solid #NcNf;border-radius:Npx;padding:.Nrem}pre code,.ui-output code{font-family:inherit;color:inherit}pre.ui-output code{background:transparent}@media(max-width:Npx){.ui-page{padding:.Nrem}.ui-grid{grid-template-columns:Nfr}.ui-card,.ui-panel{margin:.Nrem N;padding:.Nrem}}.ui-lightbox{border:Npx solid var(--ui-border);background:var(--ui-panel);color:var(--ui-fg);padding:Nrem;max-width:min(Nvw,Npx);max-height:Nvh;border-radius:var(--ui-radius)}.ui-lightbox::backdrop{background:rgba(N,N,N,.N)}.ui-lightbox img{display:block;max-width:N%;max-height:calc(Nvh - Nrem);margin:auto}.ui-lightbox-bar{display:flex;gap:.Nrem;justify-content:space-between;margin-top:.Nrem}body:has(.ui-lightbox[open]){overflow:hidden}.ui-table,.ui-elements table{border-collapse:collapse;width:N%}.ui-table th,.ui-table td,.ui-elements th,.ui-elements td{border-bottom:Npx solid var(--ui-border);padding:.Nrem .Nrem;text-align:left;vertical-align:top;overflow-wrap:anywhere}.ui-table th,.ui-elements th{color:var(--ui-muted);font-weight:N}.ui-table caption,.ui-elements caption{text-align:left;color:var(--ui-muted);padding:.Nrem N}.ui-pass{color:var(--ui-accent)}.ui-fail{color:var(--ui-danger)}.ui-changed{background:color-mix(in srgb,var(--ui-accent) N%,transparent)}.ui-tag.ui-pass{border-color:var(--ui-accent)}.ui-tag.ui-fail{border-color:var(--ui-danger)}}\n/* css/themes/terminal.css */\n/* terminal: glyphs for the token-only terminal palette in tokens.css (# titles, [tags], &gt; buttons, dark output). */\n@layer theme{body[data-ui-theme=&quot;terminal&quot;] .ui-title::before{content:&quot;# &quot;;color:var(--ui-accent)}body[data-ui-theme=&quot;terminal&quot;] .ui-tag:not(.ui-pass,.ui-fail)::before{content:&quot;[&quot;}body[data-ui-theme=&quot;terminal&quot;] .ui-tag:not(.ui-pass,.ui-fail)::after{content:&quot;]&quot;}body[data-ui-theme=&quot;terminal&quot;] .ui-button::before{content:&quot;&gt; &quot;;color:var(--ui-accent)}body[data-ui-theme=&quot;terminal&quot;] .ui-button:hover{border-color:var(--ui-accent)}body[data-ui-theme=&quot;terminal&quot;] .ui-output{background:#Na;color:var(--ui-fg);border:Npx solid var(--ui-border);border-radius:N}body[data-ui-theme=&quot;terminal&quot;] .ui-panel,body[data-ui-theme=&quot;terminal&quot;] .ui-card{box-shadow:none}}\n:root{--ui-text:Npx;--ui-space:Npx;--ui-max:Npx}\nbody:has(input[name=&quot;ui-layout&quot;][value=&quot;comfortable&quot;]:checked){--ui-text:Npx;--ui-space:Npx;--ui-max:Npx}\nbody:has(input[name=&quot;ui-layout&quot;][value=&quot;compact&quot;]:checked){--ui-text:Npx;--ui-space:Npx;--ui-max:Npx}\nbody:has(input[name=&quot;ui-layout&quot;][value=&quot;wide&quot;]:checked){--ui-text:Npx;--ui-space:Npx;--ui-max:Npx}\nbody:has(input[name=&quot;ui-layout&quot;][value=&quot;device&quot;]:checked){--ui-text:Npx;--ui-space:Npx;--ui-max:N%}\n.ui-layout-switch{display:flex;flex-wrap:wrap;gap:Npx;border:Npx solid var(--ui-border);padding:Npx;margin:Npx N}.ui-layout-switch label{display:inline-flex;gap:Npx;align-items:center}.ui-layout-switch small{color:var(--ui-muted)}\n.ui-kv{display:grid;grid-template-columns:max-content Nfr;gap:.Nrem var(--ui-space)}.ui-kv dt{color:var(--ui-muted)}.ui-kv dd{margin:N}.ui-badges .ui-tag{margin-right:.Nrem}.ui-tabs{margin:var(--ui-space) N}.ui-tab-input{position:absolute;opacity:N;pointer-events:none}.ui-tab{display:inline-block;padding:.Nrem .Nrem;margin:N .Nrem .Nrem N;border:Npx solid var(--ui-border);border-radius: