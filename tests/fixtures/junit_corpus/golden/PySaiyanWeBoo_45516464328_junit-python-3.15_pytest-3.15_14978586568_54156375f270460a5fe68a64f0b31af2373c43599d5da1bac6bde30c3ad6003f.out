[numbers,runtime]of PATTERN_PRODUCERS)if(numbers.includes(number))return runtime;\n if(PATTERN_NATIVE.includes(number)||PATTERN_GESTURES.includes(number))return<q>;\n for(const[limit,owner]of[[N,<q>],[N,<q>],[N,<q>],[N,<q>]])if(number<=limit)return owner;\n return<q>}\nexport function patternCatalogue(){\n const rows=[];\n for(const[key,letter]of PATTERN_CATEGORIES){\n  const names=PATTERN_TITLES[key].split(/\\s+/).filter(Boolean);need(names.length===N,key+<q>);\n  names.forEach((title,i)=>{const number=i+N,row={id:letter+String(number).padStart(N,<q>),category:key,number,title,theme:patternTheme(key,number)};\n   if(key===<q>){row.family=patternFamily(number);row.owner=patternOwner(number)}rows.push(row)})}\n return rows}\n/* lower-cased where Python case-folds: they differ for a few letters (a sharp s matches itself here, not <q>) */\nconst normalized=s=>s.normalize(<q>).toLowerCase();\nexport function patternFind(rows,query=<q>,category=<q>,family=<q>){\n const words=normalized(query).split(/\\s+/).filter(Boolean);\n return rows.filter(row=>{\n  if(category&&row.category!==category)return false;\n  if(family&&(row.family===undefined?null:row.family)!==family)return false;\n  const haystack=normalized(row.id+<q>+row.title+<q>+row.theme);return words.every(w=>haystack.includes(w))})}\nconst api={PatternError,cmpStr,pyEq,pyJson,patternQuery,patternPage,patternScore,patternReduce,patternWorkflow,patternTransform,patternSelect,patternOrder,patternTokens,patternWithoutStopWords,patternInvertedIndex,patternTextSearch,patternText,\n patternWindowInitial,patternWindowStep,patternWindowRender,patternCollectionInitial,patternCollectionStep,patternCollectionRender,patternStructure,patternFuture,patternStream,patternConcurrency,patternEventLoop,patternInteraction,virtualWindow,debounce,patternRun,patternTheme,patternFamily,patternOwner,patternCatalogue,patternFind,\n PATTERN_RUNNERS,PATTERN_TWINS,PATTERN_FAMILIES,PATTERN_EXAMPLES,PATTERN_ORDER_EXAMPLES,PATTERN_TEXT_DOCUMENTS,PATTERN_WINDOW_MODES,PATTERN_COLLECTION_MODES,PATTERN_WINDOW_ITEMS,shaNHex};\nglobalThis.webUiPatterns=api;\nconst el=(tag,props={},...kids)=>{const e=document.createElement(tag);for(const[k,v]of Object.entries(props))if(k===<q>)e.textContent=v;else e.setAttribute(k,v);e.append(...kids);return e};\nconst pretty=v=>JSON.stringify(v,null,N);\nconst PAGE=N;\nexport function bindPatterns(root=document){return[...root.querySelectorAll(<q>)].map(box=>{\n if(box.hasAttribute(<q>))return box;\n const $=s=>box.querySelector(s);\n const rows=patternCatalogue(),list=$(<q>),count=$(<q>),more=$(<q>),q=$(<q>),cat=$(<q>),fam=$(<q>);\n let shown=PAGE,found=rows;\n const draw=()=>{\n  list.replaceChildren(...found.slice(N,shown).map(row=>el(<q>,{<q>:row.id},el(<q>,{text:row.id}),el(<q>,{text:<q>+row.title}),\n   el(<q>,{class:<q>,text:<q>+row.theme+(row.category===<q>?<q>+(row.family||row.owner):<q>)}))));\n  count.textContent=found.length===rows.length?rows.length+<q>:found.length+<q>+rows.length+<q>;more.hidden=shown>=found.length;box.dataset.found=String(found.length);box.dataset.shown=String(Math.min(shown,found.length))};\n const search=()=>{found=patternFind(rows,q.value,cat.value,fam.value);shown=PAGE;draw()};\n q.addEventListener(<q>,search);cat.addEventListener(<q>,search);fam.addEventListener(<q>,search);more.addEventListener(<q>,()=>{shown+=PAGE;draw()});\n let runs=N;\n const bridge=box.dataset.patternsBridge||<q>;\n const runFam=$(<q>),req=$(<q>),out=$(<q>),status=$(<q>);\n const run=()=>{\n  const family=runFam.value;let request;\n  box.dataset.family=family;box.dataset.runs=String((Number(box.dataset.runs)||N)+N);\n  try{request=JSON.parse(req.value)}catch{status.textContent=<q>;out.textContent=<q>;box.dataset.run=<q>;return}\n  const example=PATTERN_EXAMPLES[family],pythonOnly=!PATTERN_TWINS.includes(family)||(family===<q>&&request!==null&&typeof request===<q>&&request.operation===<q>);\n  if(pythonOnly&&bridge){\n   box.dataset.engine=<q>;const ticket=++runs;out.tex