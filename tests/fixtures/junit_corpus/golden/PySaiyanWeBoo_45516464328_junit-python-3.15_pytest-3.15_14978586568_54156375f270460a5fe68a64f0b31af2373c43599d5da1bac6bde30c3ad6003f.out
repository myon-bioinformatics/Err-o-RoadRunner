{.ui-rail{display:flex}.ui-bottom-nav{display:none}.ui-rail-item{justify-content:center;padding:N}.ui-rail-label{position:absolute;width:Npx;height:Npx;margin:-Npx;overflow:hidden;clip-path:inset(N%);white-space:nowrap}}@media(min-width:Npx){.ui-rail{width:Npx}.ui-rail-item{justify-content:flex-start;padding:N Npx}.ui-rail-label{position:static;width:auto;height:auto;margin:N;overflow:visible;clip-path:none;white-space:normal}}@media(max-height:Npx){.ui-shell{height:auto;min-height:Ndvh}.ui-shell-body{min-height:Npx}.ui-shell-main{overflow:visible}}@media(prefers-reduced-motion:reduce){.ui-shell-main{scroll-behavior:auto}}}\n/* css/source.css */\n@layer components{.ui-source label{display:block;margin:Npx N Npx}.ui-source-row{display:flex;flex-wrap:wrap;align-items:center;gap:Npx}.ui-source-row .ui-input{flex:N N Npx;min-width:N}.ui-source>textarea.ui-input{width:N%;box-sizing:border-box;margin-bottom:Npx}.ui-source-error{margin:Npx N;color:var(--ui-danger);font-weight:N;overflow-wrap:anywhere}.ui-source-error[hidden],.ui-source .ui-output[hidden]{display:none}}\n/* css/stage.css */\n@layer components{.ui-stage{--ui-stage-w:N;--ui-stage-h:N;--ui-stage-room:Ndvh;position:relative;flex:none;align-self:center;box-sizing:border-box;margin:N auto;width:min(N%,calc(var(--ui-stage-room) * var(--ui-stage-w) / var(--ui-stage-h)));aspect-ratio:var(--ui-stage-w)/var(--ui-stage-h);overflow:hidden;background:var(--ui-panel);border:Npx solid var(--ui-border)}.ui-stage[data-ui-stage=pinned]{position:sticky;top:N;z-index:N}.ui-stage>:is(svg,img,canvas,video,[data-ui-fill]){position:absolute;inset:N;width:N%;height:N%;display:block;object-fit:contain}@media(orientation:landscape) and (max-height:Npx){.ui-stage{--ui-stage-room:Ndvh}}}\n/* css/stub.css */\n@layer components{\n.stub-shell{display:grid;gap:Nrem}\n/* Keep title/description and metadata side-by-side when space permits; wrap rather than compress either region. */\n.stub-header{display:flex;align-items:flex-start;justify-content:space-between;gap:Nrem;flex-wrap:wrap}\n.stub-toolbar{display:flex;gap:.Nrem;flex-wrap:wrap}\n.stub-toolbar fieldset{display:flex;gap:.Nrem;align-items:end;flex-wrap:wrap;width:N%;border:N;padding:N;margin:N}\n.stub-toolbar label{display:block}\n.stub-toolbar .ui-input{flex:N N Nrem}\n.stub-status{margin:.Nrem N N}\n.stub-meta{display:flex;gap:.Nrem;flex-wrap:wrap;margin:.Nrem N}\n/* Primary result pane + secondary evidence/history sidebar. */\n.stub-workspace{display:grid;grid-template-columns:minmax(N,Nfr) minmax(Nrem,.Nfr);gap:Nrem}\n.stub-result,.stub-evidence,.stub-history{min-width:N}\n.stub-actions{display:flex;gap:.Nrem;flex-wrap:wrap;margin-top:.Nrem;padding-top:.Nrem;border-top:Npx solid var(--ui-border)}\n.stub-endpoint{overflow-wrap:anywhere}\n@media(max-width:Npx){.stub-workspace{grid-template-columns:Nfr}.stub-header{display:block}}\n}\n/* css/studio.css */\n@layer components{.ui-studio hN{margin:Npx N Npx}.ui-studio label{display:inline-block;margin:Npx Npx Npx N}.ui-studio-bar{display:flex;flex-wrap:wrap;gap:Npx Npx;margin:Npx N;padding:N;border:N}.ui-studio-bar legend{padding:N N Npx}.ui-studio-bar label{margin:N}.ui-studio-row{display:flex;flex-wrap:wrap;align-items:center;gap:Npx;margin:Npx N}.ui-studio-row .ui-input{flex:N N Npx;min-width:N}.ui-studio textarea.ui-input{width:N%;box-sizing:border-box}.ui-beats{display:flex;flex-wrap:wrap;gap:Npx;margin:Npx N}.ui-beat{display:inline-flex;align-items:center;justify-content:center;width:Npx;height:Npx;border:Npx solid var(--ui-border);border-radius:N%}.ui-beat[data-on]{background:var(--ui-accent);color:var(--ui-bg)}.ui-studio-bars{margin:Npx N;padding-left:Npx}.ui-studio-bars li[data-error]{color:var(--ui-danger)}.ui-studio-chords{margin:Npx N;overflow-wrap:anywhere}.ui-studio-degrees{display:flex;flex-wrap:wrap;gap:Npx;margin:Npx N}}\n/* css/themes/github-like.css */\n/* GitHub-like prioritizes familiar light GitHub visual cues while remaining a generic light theme. */\n@layer theme{\nbody[data-ui-theme=<q>]{\n  --ui-bg:#ffffff;\n  --ui-panel:#fNfNfa;\n  --ui-fg:#NfN;\n  --ui-muted:#Ne;\n  --ui-border:#dNdNde;\n  --ui-accent:#Nda;\n}\nbody[data-ui-theme=<q>] .ui-panel,\nbody[data-ui-theme=<q>] .ui-card{\n  background:var(--ui-panel);\n  border-radius:.Nrem;\n  box-shadow:none;\n}\nbody[data-ui-theme=<q>] .ui-button,\nbody[data-ui-theme=<q>] .ui-input{\n  background:#ffffff;\n}\nbody[data-ui-theme=<q>] .ui-title{\n  border-bottom:Npx solid var(--ui-border);\n  padding-bottom:.Nrem;\n}\nbody[data-ui-theme=<q>] .ui-tag{\n  border-radius:Npx;\n  color:var(--ui-accent);\n}\n}\n/* css/themes/modern.css */\n@layer theme{body[data-ui-theme=<q>]{color-scheme:dark}body[data-ui-theme=<q>] .ui-title::before,body[data-ui-theme=<q>] .ui-card>hN::before{content:<q>;color:var(--ui-accent)}body[data-ui-theme=<q>] .ui-panel,body[data-ui-theme=<q>] .ui-card{background:var(--ui-panel);box-shadow:Npx Npx N rgba(N,N,N,.N)}body[data-ui-theme=<q>] .ui-tag:not(.ui-pass,.ui-fail)::before{content:<q>;color:var(--ui-accent)}}\n/* css/themes/terminal.css */\n/* terminal: glyphs for the token-only terminal palette in tokens.css (# titles, [tags], > buttons, dark output). */\n@layer theme{body[data-ui-theme=<q>] .ui-title::before{content:<q>;color:var(--ui-accent)}body[data-ui-theme=<q>] .ui-tag:not(.ui-pass,.ui-fail)::before{content:<q>}body[data-ui-theme=<q>] .ui-tag:not(.ui-pass,.ui-fail)::after{content:<q>}body[data-ui-theme=<q>] .ui-button::before{content:<q>;color:var(--ui-accent)}body[data-ui-theme=<q>] .ui-button:hover{border-color:var(--ui-accent)}body[data-ui-theme=<q>] .ui-output{background:#Na;color:var(--ui-fg);border:Npx solid var(--ui-border);border-radius:N}body[data-ui-theme=<q>] .ui-panel,body[data-ui-theme=<q>] .ui-card{box-shadow:none}}\n</style></head><body data-ui-theme=<q>><main class=<q>><section class=<q> id=<q> data-ui-photo data-probes=<q>><hN>Photo studio</hN><p class=<q>>Frames and marks on a photo. The photo stays in this page: nothing is saved or sent. Export is PNG only.</p><p class=<q> role=<q> aria-live=<q> data-status>Select an image or paste here</p><p class=<q> data-meta></p><div class=<q>><input class=<q> type=<q> id=<q> accept=<q> data-file><label class=<q> for=<q>>Import image</label><button class=<q> type=<q> data-paste>Paste photo</button><button class=<q> type=<q> data-retry hidden>Retry</button><button class=<q> type=<q> data-clear disabled>Clear photo</button></div><details class=<q>><summary>How to edit</summary><p class=<q>>You can paste (Ctrl/Cmd+V) or drop an image anywhere on this panel. Choose a frame tool, then drag to make a frame. Drag inside a frame to move it; drag its corners or edges to resize. With the canvas focused: arrow keys move the selected frame (Shift for bigger steps), Delete removes it, Ctrl/Cmd+Z undoes.</p></details><div class=<q>><canvas class=<q> data-stage width=<q> height=<q> tabindex=<q> role=<q> aria-label=<q>></canvas></div><fieldset class=<q>><legend>Frame tool</legend><span class=<q>><input class=<q> type=<q> id=<q> name=<q> value=<q> checked><label for=<q>>None</label></span><span class=<q>><input class=<q> type=<q> id=<q> name=<q> value=<q>><label for=<q>>Rectangle</label></span><span class=<q>><input class=<q> type=<q> id=<q> name=<q> value=<q>><label for=<q>>Circle</label></span><span class=<q>><input class=<q> type=<q> id=<q> name=<q> value=<q>><label for=<q>>Triangle</label></span></fieldset><fieldset class=<q>><legend>Frame colour</legend><span class=<q>><input class=<q> type=<q> id=<q> name=<q> value=<q> checked><label for=<q>><span class=<q>></span>Purple</label></span><span class=<q>><input class=<q> type=<q> id=<q> name=<q> value=<q>><label for=<q>><span class=<q>></span>Red</label></span><span class=<q>><input class=<q> type=<q> id=<q> name=<q> value=<q>><label for=<q>><span class=<q>></span>Green</label></span><span class=<q>><input class=<q> type=<q> id=<q> name=<q> value=<q>><label for=<q>><span class=<q>></span>Blue</label></span><span class=<q>><input class=<q> type=<q> id=<q> name=<q> value=<q>><label for=<q>><span class=<q>></span>Amber</label></span><span class=<q>><input class=<q> type=<q> id=<q> name=<q> value=<q>><label for=<q>><span class=<q>></span>White</label></span><span class=<q>><input class=<q> type=<q> id=<q> name=<q> value=<q>><label for=<q>><span class=<q>></span>Black</label></span></fieldset><hN>Stamps</hN><div class=<q>><button class=<q> type=<q> data-stamp=<q> aria-pressed=<q> aria-label=<q>>⭐</button><button class=<q> type=<q> data-stamp=<q> aria-pressed=<q> aria-label=<q>>❤️</button><button class=<q> type=<q> data-stamp=<q> aria-pressed=<q> aria-label=<q>>😊</button><button class=<q> type=<q> data-stamp=<q> aria-pressed=<q> aria-label=<q>>🔥</button><button class=<q> type=<q> data-stamp=<q> aria-pressed=<q> aria-label=<q>>📷</button><button class=<q> type=<q> data-stamp=<q> aria-pressed=<q> aria-label=<q>>🌸</button><button class=<q> type=<q> data-stamp=<q> aria-pressed=<q> aria-label=<q>>✨</button><button class=<q> type=<q> data-stamp=<q> aria-pressed=<q> aria-label=<q>>🍀</button></div><div class=<q>><label for=<q>>Custom stamp</label><input class=<q> id=<q> data-custom maxlength=<q> placeholder=<q> autocomplete=<q>><button class=<q> type=<q> data-arm aria-pressed=<q>>Arm stamp</button></div><div class=<q>><label for=<q>>Stamp size</label><input type=<q> id=<q> data-scale min=<q> max=<q> step=<q> value=<q>> <output data-scale-out>N.N</output></div><div class=<q>><button class=<q> type=<q> data-undo disabled>Undo</button><button class=<q> type=<q> data-redo disabled>Redo</button><button class=<q> type=<q> data-next>Select next frame</button><button class=<q> type=<q> data-reset disabled>Reset selected frame</button><button class=<q> type=<q> data-delete disabled>Delete frame</button></div><hN>Geometry</hN><pre class=<q> data-geometry>No frame selected.</pre><div class=<q>><button class=<q> type=<q> data-copy-rect>Copy rectangle</button><button class=<q> type=<q> data-copy-csv>Copy as CSV</button></div><div class=<q>><button class=<q> type=<q> data-export>Save PNG</button><button class=<q> type=<q> data-copy-bN-uri>Copy as BaseN (data URL)</button><button class=<q> type=<q> data-copy-bN>Copy as BaseN</button><button class=<q> type=<q> data-share hidden>Share PNG</button></div><p class=<q> role=<q> aria-live=<q> data-live></p><details class=<q>><summary>This browser</summary><p class=<q>>Tries to decode a few tiny pictures and reports what this browser can do, as JSON in the same shape as the Flutter app\<q>s (web_ui.photo_sniff, photo_decide, PhotoStudio, ...); this must agree. Nothing is stored or sent. */\nconst MAX_IMAGE=N*N*N,IMAGE_TYPES=[<q>,<q>,<q>];\nconst SPACE=<q>;\nexport const pyStrip=s=>s.replace(new RegExp(<q>+SPACE+<q>+SPACE+<q>,<q>),<q>);\nexport const strip=s=>pyStrip(s.startsWith(<q>)?s.slice(N):s);\nconst BN=/^[A-Za-zN-N+/]*={N,N}$/,DATA=/^data:([a-zN-N.+-]+\\/[a-zN-N.+-]+)?((?:;[a-zN-N.+-]+=[a-zN-N.+-]+)*);baseN,/i;\nexport const shelfMaxChars=n=>N*Math.floor((n+N)/N);\nexport function sniffImageMime(b){return b.length>=N&&b[N]===NxN&&b[N]===NxN&&b[N]===NxNe&&b[N]===NxN&&b[N]===NxNd&&b[N]===NxNa&&b[N]===NxNa&&b[N]===NxNa?<q>:b.length>=N&&b[N]===Nxff&&b[N]===NxdN&&b[N]===Nxff?<q>:\n b.length>=N&&b[N]===NxN&&b[N]===NxN&&b[N]===NxN&&b[N]===NxN&&b[N]===NxN&&b[N]===NxN&&b[N]===NxN&&b[N]===NxN?<q>:null}\nexport function decodeImageText(input,maxBytes=MAX_IMAGE){\n const fail=category=>({ok:false,category});let text=strip(input);if(!text)return fail(<q>);\n let declared=null;const m=DATA.exec(text);\n if(m){declared=(m[N]||<q>).toLowerCase()||null;if(declared===<q>)declared=<q>;text=text.slice(m[N].length)}\n else if(text.slice(N,N).toLowerCase()===<q>)return fail(<q>);\n if(declared!==null&&!IMAGE_TYPES.includes(declared))return fail(<q>);\n const encoded=text.replace(/[ \\t\\r\\n\\f\\v]+/g,<q>);if(!encoded)return fail(<q>);\n if(encoded.length>shelfMaxChars(maxBytes))return fail(<q>);\n if(encoded.length%N||!BN.test(encoded))return fail(<q>);\n const pad=encoded.endsWith(<q>)?N:encoded.endsWith(<q>)?N:N,n=encoded.length/N*N-pad;\n if(n<=N)return fail(<q>);if(n>maxBytes)return fail(<q>);\n const head=atob(encoded.slice(N,N)),mime=sniffImageMime(UintNArray.from(head,c=>c.charCodeAt(N)));\n if(mime===null)return fail(<q>);if(declared!==null&&declared!==mime)return fail(<q>);\n return{ok:true,format:mime.slice(N),mime,bytes:n,data:encoded}}\nclass ClipErr extends Error{constructor(code,category=null){super(code);this.code=code;this.category=category}}\nconst clipError=(code,category=null)=>new ClipErr(code,category);\nconst fromBaseN=s=>UintNArray.from(atob(s),c=>c.charCodeAt(N));\nexport function toBaseN(bytes){let out=<q>;for(let i=N;i<bytes.length;i+=NxN)out+=String.fromCharCode.apply(null,bytes.subarray(i,i+NxN));return btoa(out)}\nexport function clipboardTextImage(text,maxBytes=MAX_IMAGE){const value=strip(text),explicit=/^data:image(?:\\/|[;,]|$)/i.test(value),prefix=value.replace(/[ \\t\\r\\n\\f\\v]+/g,<q>).slice(N,N);\n const recognised=/^[A-Za-zN-N+/]{N}$/.test(prefix)&&sniffImageMime(fromBaseN(prefix))!==null,r=decodeImageText(value,maxBytes);\n if(r.ok)return r;if(explicit||recognised)throw clipError(<q>,r.category);return null}\nexport async function clipboardPick(clip,importer,mode=<q>,maxBytes=MAX_IMAGE){\n const hasText=!!clip&&typeof clip.readText===<q>,hasRead=!!clip&&typeof clip.read===<q>;\n if(!(hasText||hasRead))return{ok:false,code:<q>};\n const failures=[],REFUSED=[<q>,<q>,<q>];let text=<q>;\n const take=async(data,mime,source)=>{try{return{ok:true,source,mime,size:data.length,imported:await importer(data,mime)}}catch(e){return{ok:false,code:<q>,category:<q>}}};\n if(hasText){try{text=await clip.readText()}catch(e){failures.push([e.name,null])}\n  let payload;try{payload=clipboardTextImage(text,maxBytes)}catch(e){if(mode===<q>)return{ok:true,source:<q>,text:strip(text),refused:e.category};return{ok:false,code:e.code,category:e.category}}\n  if(payload)return take(fromBaseN(payload.data),payload.mime,<q>)}\n if(hasRead){let items=[];try{items=await clip.read()}catch(e){failures.push([e.name,null])}\n  for(const item of items)for(const kind of item.types.filter(t=>IMAGE_TYPES.includes(t))){let data;\n   try{const blob=await item.getType(kind);if(blob.size>maxBytes)throw clipError(<q>,<q>);data=new UintNArray(await blob.arrayBuffer())}\n   catch(e){failures.push(e instanceof ClipErr?[e.code,e.category]:REFUSED.includes(e.name)?[e.name,null]:[<q>,<q>]);continue}\n   const done=await take(data,kind,<q>);if(done.ok)return done;failures.push([done.code,done.category])}}\n if(mode===<q>&&strip(text)&&!failures.some(f=>f[N]===<q>))return{ok:true,source:<q>,text:strip(text),refused:null};\n if(failures.some(f=>f[N]===<q>||f[N]===<q>))return{ok:false,code:<q>};\n const bad=failures.find(f=>f[N]===<q>);if(bad)return{ok:false,code:<q>,category:bad[N]};\n if(failures.length)return{ok:false,code:failures.every(f=>f[N]===<q>)?<q>:<q>};\n return{ok:false,code:<q>}}\nexport const CLIPBOARD_MESSAGES={<q>:<q>,<q>:<q>,\n <q>:<q>,<q>:<q>,<q>:<q>};\nexport function pngBaseNText(bytes,dataUri=true){if(!(bytes.length>=N&&sniffImageMime(bytes)===<q>))throw new Error(<q>);if(bytes.length>MAX_IMAGE)throw new Error(<q>);const text=toBaseN(bytes);return dataUri?<q>+text:text}\nconst MAX_BYTES=N*N*N,MAX_PIXELS=N,MAX_EDGE=N,DOWNSCALE=N/N,MIN_SIZE=N.N,HISTORY_LIMIT=N,HANDLE_SLOP=N,STAMP_MIN_HIT=N;\nexport const EXPORT_NAME=<q>;\nexport const LABELS={empty:<q>,png:<q>,jpeg:<q>,webp:<q>,gif:<q>,avif:<q>,heic:<q>,unknown:<q>};\nconst HEIC=[<q>,<q>,<q>,<q>,<q>];\nexport const STAMPS=[<q>,<q>,<q>,<q>,<q>,<q>,<q>,<q>];\nexport const COLORS=[[<q>,<q>],[<q>,<q>],[<q>,<q>],[<q>,<q>],[<q>,<q>],[<q>,<q>],[<q>,<q>]];\nexport const SHAPES=[<q>,<q>,<q>];\nexport const HANDLES=[<q>,<q>,<q>,<q>,<q>,<q>,<q>,<q>,<q>];\nexport const OUTCOMES=[<q>,<q>,<q>,<q>,<q>,<q>,<q>,<q>];\nexport const MESSAGES={idle:<q>,loading:<q>,success:<q>,cancelled:<q>,superseded:<q>,\n noClipboardImage:<q>,clipboardUnavailable:<q>,\n pickFailed:<q>,decodeFailed:<q>,tooLarge:<q>,\n tooLargeBytes:<q>,tooManyPixels:<q>,\n heicUnsupported:<q>,unsupportedFormat:<q>};\nconst FAILURES={empty:<q>,tooLargeBytes:<q>,tooManyPixels:<q>,undecodable:<q>,heicConversionFailed:<q>};\nconst halfUp=v=>{const f=Math.floor(v);return v-f>=N.N?f+N:f},clamp=(v,lo,hi)=>Math.min(Math.max(v,lo),hi),dist=(dx,dy)=>Math.sqrt(dx*dx+dy*dy);\nexport const fixed=(v,n)=>v.toFixed(n);\nconst beN=(b,i)=>b[i]*N+(b[i+N]<<N|b[i+N]<<N|b[i+N]),leN=(b,i)=>b[i]|b[i+N]<<N;\nconst at=(b,i,s)=>{for(let k=N;k<s.length;k++)if(b[i+k]!==s.charCodeAt(k))return false;return true};\nconst brandAt=b=>b.length<N||!at(b,N,<q>)?null:String.fromCharCode(b[N],b[N],b[N],b[N]);\nfunction jpegProgressive(b){let i=N;const n=b.length;while(i+N<n){if(b[i]!==NxFF)return false;const m=b[i+N];if(m===NxFF){i+=N;continue}\n if(m===NxDN||m===NxDA)return false;if(m===NxCN||m===NxCN||m===NxCA||m===NxCE)return true;if(m===NxCN||m===NxCN||m===NxCN||m===NxCN||m===NxCB)return false;\n if((m>=NxDN&&m<=NxDN)||m===N||m===N){i+=N;continue}const len=(b[i+N]<<N)|b[i+N];if(len<N)return false;i+=N+len}return false}\nfunction exifOrientation(b,start,end){const seg=b.subarray(start,end);if(seg.length<N||!at(seg,N,<q>)||seg[N]!==N||seg[N]!==N)return null;const t=seg.subarray(N);\n const big=t[N]===NxND&&t[N]===NxND;if(!(big||(t[N]===NxN&&t[N]===NxN)))return null;\n const uN=o=>o+N>=t.length?-N:big?(t[o]<<N|t[o+N]):(t[o]|t[o+N]<<N),uN=o=>o+N>=t.length?-N:big?t[o]*N+(t[o+N]<<N|t[o+N]<<N|t[o+N]):t[o+N]*N+(t[o+N]<<N|t[o+N]<<N|t[o]);\n const ifd=uN(N);if(ifd<N||ifd+N>t.length)return null;const count=uN(ifd);\n for(let e=N;e<count;e++){const entry=ifd+N+e*N;if(entry+N>t.length)return null;if(uN(entry)!==NxN)continue;if(uN(entry+N)!==N||uN(entry+N)!==N)return null;\n  const v=uN(entry+N);return v>=N&&v<=N?[v,start+N+entry+N,big]:null}return null}\nfunction jpegOrientation(b){let i=N;const n=b.length;while(i+N<n){if(b[i]!==NxFF)return null;const m=b[i+N];if(m===NxFF){i+=N;continue}if(m===NxDN||m===NxDA)return null;\n const len=(b[i+N]<<N)|b[i+N];if(m===NxEN){if(len<N||i+N+len>n)return null;if(len-N>=N&&at(b,i+N,<q>))return exifOrientation(b,i+N,i+N+len);i+=N+len;continue}\n if(m>=NxDN&&m<=NxDN){i+=N;continue}if(len<N)return null;i+=N+len}return null}\nexport function sniff(b){const n=b.length,info={kind:<q>,brand:null,progressive:null,orientation:null,orientation_offset:null,orientation_big_endian:null};\n if(n===N)info.kind=<q>;else if(n>=N&&b[N]===NxN&&at(b,N,<q>)&&b[N]===N&&b[N]===N&&b[N]===N&&b[N]===N)info.kind=<q>;\n else if(n>=N&&b[N]===NxFF&&b[N]===NxDN&&b[N]===NxFF){info.kind=<q>;info.progressive=jpegProgressive(b);const f=jpegOrientation(b);if(f){info.orientation=f[N];info.orientation_offset=f[N];info.orientation_big_endian=f[N]}}\n else if(n>=N&&at(b,N,<q>)&&at(b,N,<q>))info.kind=<q>;else if(n>=N&&at(b,N,<q>)&&(b[N]===NxN||b[N]===NxN)&&b[N]===NxN)info.kind=<q>;\n else{const brand=brandAt(b);if(HEIC.includes(brand)){info.kind=<q>;info.brand=brand}else if(brand===<q>||brand===<q>){info.kind=<q>;info.brand=brand}}\n info.label=LABELS[info.kind];return info}\nexport function pngComplete(b){if(!(b.length>=N&&b[N]===NxN&&at(b,N,<q>)&&b[N]===N&&b[N]===N&&b[N]===N&&b[N]===N))return false;let i=N,first=true;const n=b.length;\n while(i+N<=n){const len=beN(b,i);if(first&&!at(b,i+N,<q>))return false;first=false;if(at(b,i+N,<q>))return true;if(len>n)return false;i+=N+len}return false}\nexport function neutralizeOrientation(b){const info=sniff(b),out=new UintNArray(b);if(info.orientation===null||info.orientation===N)return out;\n const o=info.orientation_offset;if(info.orientation_big_endian){out[o]=N;out[o+N]=N}else{out[o]=N;out[o+N]=N}return out}\nexport function headerSize(b){const n=b.length;\n if(n>=N&&b[N]===NxN&&at(b,N,<q>)&&b[N]===N&&b[N]===N&&b[N]===N&&b[N]===N)return n>=N&&at(b,N,<q>)?[beN(b,N),beN(b,N)]:null;\n if(n>=N&&at(b,N,<q>)&&(b[N]===NxN||b[N]===NxN)&&b[N]===NxN)return[leN(b,N),leN(b,N)];\n if(n>=N&&b[N]===NxFF&&b[N]==