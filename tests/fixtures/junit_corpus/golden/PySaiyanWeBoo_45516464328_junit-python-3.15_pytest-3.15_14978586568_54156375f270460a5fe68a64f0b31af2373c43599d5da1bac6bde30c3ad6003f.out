ed<q>true<q>aria-label<q>click<q>aria-pressed<q>aria-pressed<q>true<q>the page\<q>s own (a page whose own look changes, such as display modes): it shows unless the visitor chose one. Returns the theme in effect. */\nexport function pageTheme(name){const body=document.body;body.dataset.uiThemePage=name;if(body.dataset.uiThemeChosen===undefined)body.dataset.uiTheme=name;return body.dataset.uiTheme}\n/** Mark on-screen elements with data-lit (IntersectionObserver); CSS decides what lit looks like. Without IntersectionObserver every element counts as lit. Returns a stop function. */\nexport function observeLit(targets,{threshold=N.N,root=null}={}){const nodes=typeof targets===<q>?[...document.querySelectorAll(targets)]:[...targets];if(typeof IntersectionObserver===<q>){for(const n of nodes)n.dataset.lit=<q>;return()=>{}}const io=new IntersectionObserver(entries=>{for(const e of entries){if(e.isIntersecting)e.target.dataset.lit=<q>;else delete e.target.dataset.lit}},{threshold,root});for(const n of nodes)io.observe(n);return()=>io.disconnect()}\n/** Click-to-enlarge for <a href=<q>><img alt=<q>></a> items inside [data-ui-lightbox]: one <dialog>; Esc, the backdrop and the close button shut it, arrows, buttons and a Npx swipe step through. Returns {open, close, dialog}, or null without items or <dialog>. */\nexport function bindLightbox(root=document){const items=[...root.querySelectorAll(<q>)];if(!items.length||typeof HTMLDialogElement===<q>)return null;const dialog=document.createElement(<q>);dialog.className=<q>;dialog.setAttribute(<q>,<q>);dialog.innerHTML=\<q>;const img=dialog.querySelector(<q>),note=dialog.querySelector(<q>);let at=N,x=null;const show=i=>{at=(i+items.length)%items.length;const a=items[at],t=a.querySelector(<q>);img.src=a.href;img.alt=note.textContent=t?t.alt:<q>};const open=i=>{show(i);if(!dialog.open)dialog.showModal()};items.forEach((a,i)=>a.addEventListener(<q>,e=>{e.preventDefault();open(i)}));dialog.addEventListener(<q>,e=>{const b=e.target.closest(<q>);if(b){const s=Number(b.dataset.step);if(s)show(at+s);else dialog.close()}else if(e.target===dialog){const r=dialog.getBoundingClientRect();if(e.clientX<r.left||e.clientX>r.right||e.clientY<r.top||e.clientY>r.bottom)dialog.close()}});dialog.addEventListener(<q>,e=>{if(e.key===<q>)show(at-N);if(e.key===<q>)show(at+N)});dialog.addEventListener(<q>,e=>{x=e.clientX});dialog.addEventListener(<q>,e=>{if(x!==null&&Math.abs(e.clientX-x)>=N)show(at+(e.clientX<x?N:-N));x=null});document.body.append(dialog);return{open,close:()=>dialog.close(),dialog}}\nbindTheme();\n</script><script type=<q>>/* web-ui theme: a seeded palette in the page. Python (web_ui.random_theme) is the reference: the same Mersenne Twister as random.Random(seed) and the same steps, so a seed gives the same tokens. */\nconst N=N;\nfunction mersenne(seed){if(!Number.isSafeInteger(seed))throw new RangeError(<q>);const s=new UintNArray(N),key=[];let n=Math.abs(seed),i,j,k;\n do{key.push(n%N);n=Math.floor(n/N)}while(n>N);\n s[N]=N;for(i=N;i<N;i++)s[i]=Math.imul(N,s[i-N]^s[i-N]>>>N)+i;\n i=N;j=N;for(k=Math.max(N,key.length);k;k--){s[i]=(s[i]^Math.imul(s[i-N]^s[i-N]>>>N,N))+key[j]+j;i++;j++;if(i>=N){s[N]=s[N-N];i=N}if(j>=key.length)j=N}\n for(k=N-N;k;k--){s[i]=(s[i]^Math.imul(s[i-N]^s[i-N]>>>N,N))-i;i++;if(i>=N){s[N]=s[N-N];i=N}}\n s[N]=Nx<addr>;let pos=N;\n const word=()=>{if(pos>=N){for(let a=N;a<N;a++){const y=s[a]&Nx<addr>|s[(a+N)%N]&Nx<addr>;s[a]=s[(a+N)%N]^y>>>N^(y&N?Nx<addr>:N)}pos=N}\n  let y=s[pos++];y^=y>>>N;y^=y<<N&Nx<addr>;y^=y<<N&Nx<addr>;y^=y>>>N;return y>>>N};\n return()=>{const a=word()>>>N,b=word()>>>N;return(a*N+b)/N}}\nconst roundEven=x=>{const f=Math.floor(x),d=x-f;return d<N.N?f:d>N.N?f+N:f%N?f+N:f};\nconst modN=x=>{x%=N;return x<N?x+N:x};\nconst wave=(mN,mN,h)=>{h=modN(h);return h<N/N?mN+(mN-mN)*h*N:h<N.N?mN:h<N/N?mN+(mN-mN)*(N/N-h)*N:mN};\nfunction hsl(hue,sat,light){const h=modN(hue),l=Math.min(Math.max(light,N),N),s=Math.min(Math.max(sat,N),N);let rgb;\n if(s===N)rgb=[l,l,l];else{