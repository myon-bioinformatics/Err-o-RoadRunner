td[data-num],.ui-table th[data-num]{text-align:right;font-variant-numeric:tabular-nums}.ui-table td img,.ui-table th img{display:block;max-width:none;height:auto;margin:N N Npx}.ui-table td[data-missing]{color:var(--ui-muted)}.ui-table td{white-space:pre-line}.ui-shell-scroll{overflow-x:auto}.ui-shell-controls{display:flex;flex-wrap:wrap;align-items:center;gap:Npx}.ui-bottom-nav{display:flex;border-top:Npx solid var(--ui-border);background:var(--ui-panel)}.ui-bottom-item{flex:N;flex-direction:column;justify-content:center;gap:N;min-height:Npx;padding:Npx N;text-align:center}@media(min-width:Npx){.ui-rail{display:flex}.ui-bottom-nav{display:none}.ui-rail-item{justify-content:center;padding:N}.ui-rail-label{position:absolute;width:Npx;height:Npx;margin:-Npx;overflow:hidden;clip-path:inset(N%);white-space:nowrap}}@media(min-width:Npx){.ui-rail{width:Npx}.ui-rail-item{justify-content:flex-start;padding:N Npx}.ui-rail-label{position:static;width:auto;height:auto;margin:N;overflow:visible;clip-path:none;white-space:normal}}@media(max-height:Npx){.ui-shell{height:auto;min-height:Ndvh}.ui-shell-body{min-height:Npx}.ui-shell-main{overflow:visible}}@media(prefers-reduced-motion:reduce){.ui-shell-main{scroll-behavior:auto}}}\n/* css/source.css */\n@layer components{.ui-source label{display:block;margin:Npx N Npx}.ui-source-row{display:flex;flex-wrap:wrap;align-items:center;gap:Npx}.ui-source-row .ui-input{flex:N N Npx;min-width:N}.ui-source>textarea.ui-input{width:N%;box-sizing:border-box;margin-bottom:Npx}.ui-source-error{margin:Npx N;color:var(--ui-danger);font-weight:N;overflow-wrap:anywhere}.ui-source-error[hidden],.ui-source .ui-output[hidden]{display:none}}\n/* css/stage.css */\n@layer components{.ui-stage{--ui-stage-w:N;--ui-stage-h:N;--ui-stage-room:Ndvh;position:relative;flex:none;align-self:center;box-sizing:border-box;margin:N auto;width:min(N%,calc(var(--ui-stage-room) * var(--ui-stage-w) / var(--ui-stage-h)));aspect-ratio:var(--ui-stage-w)/var(--ui-stage-h);overflow:hidden;background:var(--ui-panel);border:Npx solid var(--ui-border)}.ui-stage[data-ui-stage=pinned]{position:sticky;top:N;z-index:N}.ui-stage>:is(svg,img,canvas,video,[data-ui-fill]){position:absolute;inset:N;width:N%;height:N%;display:block;object-fit:contain}@media(orientation:landscape) and (max-height:Npx){.ui-stage{--ui-stage-room:Ndvh}}}\n/* css/stub.css */\n@layer components{\n.stub-shell{display:grid;gap:Nrem}\n/* Keep title/description and metadata side-by-side when space permits; wrap rather than compress either region. */\n.stub-header{display:flex;align-items:flex-start;justify-content:space-between;gap:Nrem;flex-wrap:wrap}\n.stub-toolbar{display:flex;gap:.Nrem;flex-wrap:wrap}\n.stub-toolbar fieldset{display:flex;gap:.Nrem;align-items:end;flex-wrap:wrap;width:N%;border:N;padding:N;margin:N}\n.stub-toolbar label{display:block}\n.stub-toolbar .ui-input{flex:N N Nrem}\n.stub-status{margin:.Nrem N N}\n.stub-meta{display:flex;gap:.Nrem;flex-wrap:wrap;margin:.Nrem N}\n/* Primary result pane + secondary evidence/history sidebar. */\n.stub-workspace{display:grid;grid-template-columns:minmax(N,Nfr) minmax(Nrem,.Nfr);gap:Nrem}\n.stub-result,.stub-evidence,.stub-history{min-width:N}\n.stub-actions{display:flex;gap:.Nrem;flex-wrap:wrap;margin-top:.Nrem;padding-top:.Nrem;border-top:Npx solid var(--ui-border)}\n.stub-endpoint{overflow-wrap:anywhere}\n@media(max-width:Npx){.stub-workspace{grid-template-columns:Nfr}.stub-header{display:block}}\n}\n/* css/studio.css */\n@layer components{.ui-studio hN{margin:Npx N Npx}.ui-studio label{display:inline-block;margin:Npx Npx Npx N}.ui-studio-bar{display:flex;flex-wrap:wrap;gap:Npx Npx;margin:Npx N;padding:N;border:N}.ui-studio-bar legend{padding:N N Npx}.ui-studio-bar label{margin:N}.ui-studio-row{display:flex;flex-wrap:wrap;align-items:center;gap:Npx;margin:Npx N}.ui-studio-row .ui-input{flex:N N Npx;min-width:N}.ui-studio textarea.ui-input{width:N%;box-sizing:border-box}.ui-beats{display:flex;flex-wrap:wrap;gap:Npx;margin:Npx N}.ui-beat{display:inline-flex;align-items:center;justify-content:center;width:Npx;height:Npx;border:Npx solid var(--ui-border);border-radius:N%}.ui-beat[data-on]{background:var(--ui-accent);color:var(--ui-bg)}.ui-studio-bars{margin:Npx N;padding-left:Npx}.ui-studio-bars li[data-error]{color:var(--ui-danger)}.ui-studio-chords{margin:Npx N;overflow-wrap:anywhere}.ui-studio-degrees{display:flex;flex-wrap:wrap;gap:Npx;margin:Npx N}}\n/* css/themes/github-like.css */\n/* GitHub-like prioritizes familiar light GitHub visual cues while remaining a generic light theme. */\n@layer theme{\nbody[data-ui-theme=<q>]{\n  --ui-bg:#ffffff;\n  --ui-panel:#fNfNfa;\n  --ui-fg:#NfN;\n  --ui-muted:#Ne;\n  --ui-border:#dNdNde;\n  --ui-accent:#Nda;\n}\nbody[data-ui-theme=<q>] .ui-panel,\nbody[data-ui-theme=<q>] .ui-card{\n  background:var(--ui-panel);\n  border-radius:.Nrem;\n  box-shadow:none;\n}\nbody[data-ui-theme=<q>] .ui-button,\nbody[data-ui-theme=<q>] .ui-input{\n  background:#ffffff;\n}\nbody[data-ui-theme=<q>] .ui-title{\n  border-bottom:Npx solid var(--ui-border);\n  padding-bottom:.Nrem;\n}\nbody[data-ui-theme=<q>] .ui-tag{\n  border-radius:Npx;\n  color:var(--ui-accent);\n}\n}\n/* css/themes/modern.css */\n@layer theme{body[data-ui-theme=<q>]{color-scheme:dark}body[data-ui-theme=<q>] .ui-title::before,body[data-ui-theme=<q>] .ui-card>hN::before{content:<q>;color:var(--ui-accent)}body[data-ui-theme=<q>] .ui-panel,body[data-ui-theme=<q>] .ui-card{background:var(--ui-panel);box-shadow:Npx Npx N rgba(N,N,N,.N)}body[data-ui-theme=<q>] .ui-tag:not(.ui-pass,.ui-fail)::before{content:<q>;color:var(--ui-accent)}}\n/* css/themes/terminal.css */\n/* terminal: glyphs for the token-only terminal palette in tokens.css (# titles, [tags], > buttons, dark output). */\n@layer theme{body[data-ui-theme=<q>] .ui-title::before{content:<q>;color:var(--ui-accent)}body[data-ui-theme=<q>] .ui-tag:not(.ui-pass,.ui-fail)::before{content:<q>}body[data-ui-theme=<q>] .ui-tag:not(.ui-pass,.ui-fail)::after{content:<q>}body[data-ui-theme=<q>] .ui-button::before{content:<q>;color:var(--ui-accent)}body[data-ui-theme=<q>] .ui-button:hover{border-color:var(--ui-accent)}body[data-ui-theme=<q>] .ui-output{background:#Na;color:var(--ui-fg);border:Npx solid var(--ui-border);border-radius:N}body[data-ui-theme=<q>] .ui-panel,body[data-ui-theme=<q>] .ui-card{box-shadow:none}}\n</style></head><body data-ui-theme=<q>><main class=<q>><section class=<q> id=<q> data-ui-coord><hN>Coordinates</hN><p class=<q>>Check a point, read it from a Google or Apple Maps URL, and frame a tolerance area around it. Everything is computed in this page; short links (maps.app.goo.gl) are not expanded: paste the full address.</p><label for=<q>>Latitude</label><input class=<q> id=<q> data-lat value=<q> inputmode=<q> autocomplete=<q>><label for=<q>>Longitude</label><input class=<q> id=<q> data-lon value=<q> inputmode=<q> autocomplete=<q>><label for=<q>>Or paste a Maps URL</label><input class=<q> id=<q> data-url autocomplete=<q>><p><button class=<q> type=<q> data-use-url>Use this URL</button></p><p class=<q> role=<q> aria-live=<q> data-status></p><fieldset class=<q>><legend>Tolerance</legend><label><input type=<q> name=<q> value=<q>> Exact / GPS (N m)</label><label><input type=<q> name=<q> value=<q> checked> Building / facility (N m)</label><label><input type=<q> name=<q> value=<q>> Station / campus (N m)</label><label><input type=<q> name=<q> value=<q>> Park / large facility (N m)</label><label><input type=<q> name=<q> value=<q>> District / loose area (N m)</label><label><input type=<q> name=<q> value=<q>> Custom</label></fieldset><label for=<q>>Custom radius (metres)</label><input class=<q> id=<q> data-radius type=<q> min=<q> step=<q> value=<q>><label for=<q>>Tile zoom (N to N)</label><input class=<q> id=<q> data-zoom type=<q> min=<q> max=<q> step=<q> value=<q>><dl data-out></dl></section></main><script type=<q>>/* web-ui coordinates: validate and format a point, read it from a Maps URL, frame a tolerance area, find its XYZ tile. Python (web_ui.parse_coordinate, tolerance_area, ...) is the reference. */\nconst SPACE=<q>;\nconst strip=s=>(s.startsWith(<q>)?s.slice(N):s).replace(new RegExp(<q>+SPACE+<q>+SPACE+<q>,<q>),<q>);\nconst ascii=s=>{let o=<q>;for(const c of s){const n=c.codePointAt(N);o+=n>=NxFFN&&n<=NxFFNE?String.fromCodePoint(n-NxFEEN):n===NxN?<q>:n===NxN?<q>:c}return o};\nconst NUMBER=/^[+-]?(?:[N-N]+\\.?[N-N]*|\\.[N-N]+)(?:[eE][+-]?[N-N]+)?$/,WS=<q>,N=<q>;\nconst PATTERNS=[new RegExp(<q>+N+WS+<q>+WS+<q>+N,<q>),new RegExp(<q>+N+WS+<q>+WS+<q>+N,<q>),new RegExp(<q>+N+<q>+N),new RegExp(<q>+N+WS+<q>+WS+<q>+N+<q>)];\nexport const fixed=(v,n)=>v.toFixed(n);\nexport function parseCoordinate(latitude,longitude){const v=[];for(const raw of[latitude,longitude]){const t=strip(ascii(String(raw)));\n  if([<q>,<q>,<q>,<q>].includes(t))throw new Error(<q>);\n  if(!NUMBER.test(t))throw new Error(<q>);v.push(Number(t))}\n const[lat,lon]=v;if(!Number.isFinite(lat)||!Number.isFinite(lon))throw new Error(<q>);\n if(!(lat>=-N&&lat<=N))throw new Error(<q>);if(!(lon>=-N&&lon<=N))throw new Error(<q>);return[lat,lon]}\nconst decode=t=>{try{return decodeURIComponent(t)}catch(e){throw new Error(<q>)}};\nexport function tryParseMapsUrl(text){const raw=strip(ascii(text));if(!raw)return null;const plus=raw.split(<q>).join(<q>),candidates=[plus];\n try{candidates.push(decode(plus))}catch(e){}\n let again=plus;for(let i=N;i<N;i++){let next;try{next=decode(again)}catch(e){break}if(next===again)break;again=next}candidates.push(again);\n for(const c of candidates)for(const p of PATTERNS){const m=p.exec(c);if(m){try{return parseCoordinate(m[N],m[N])}catch(e){}}}return null}\nexport function toDms(value,isLat){const abs=Math.abs(value);let degrees=Math.floor(abs);const mv=(abs-degrees)*N;let minutes=Math.floor(mv),seconds=Number(((mv-minutes)*N).toFixed(N));\n if(seconds>=N){seconds=N;minutes+=N;if(minutes>=N){minutes=N;degrees+=N}}\n const h=isLat?(value<N?<q>:<q>):(value<N?<q>:<q>);return degrees+<q>+String(minutes).padStart(N,<q>)+<q>+seconds.toFixed(N).padStart(N,<q>)+<q>+h}\nexport const coordinateText=(lat,lon)=>fixed(lat,N)+<q>+fixed(lon,N),dmsText=(lat,lon)=>toDms(lat,true)+<q>+toDms(lon,false);\nconst normLon=v=>{while(v<-N)v+=N;while(v>N)v-=N;return v};\nexport function toleranceArea(lat,lon,radius){if(!Number.isFinite(radius)||radius<=N)throw new Error(<q>);\n const angular=radius/N.N,latDelta=angular*N/Math.PI,south=Math.max(-N,lat-latDelta),north=Math.min(N,lat+latDelta),cosine=Math.abs(Math.cos(lat*Math.PI/N));\n const lonDelta=south<=-N||north>=N||cosine<Ne-N?N:Math.min(N,angular/cosine*N/Math.PI),rawWest=lon-lonDelta,rawEast=lon+lonDelta,full=lonDelta>=N;\n const west=full?-N:normLon(rawWest),east=full?N:normLon(rawEast),wraps=!full&&(rawWest<-N||rawEast>N),span=full?N:wraps?(N-west)+(east+N):Math.abs(east-west);\n return{lat,lon,radius_m:radius,south,west,north,east,wraps,full_longitude:full,apple_span:!wraps&&!full,lat_span:Math.abs(north-south),lon_span:span}}\nexport function zoomForRadius(radius,latitude=N){if(!Number.isFinite(radius)||radius<=N)return N;const cosine=Math.min(Math.max(Math.abs(Math.cos(latitude*Math.PI/N)),Ne-N),N);\n return Math.min(Math.max(Math.floor(Math.log(N.N*cosine/(radius*N))/Math.log(N)),N),N)}\nexport function xyzTile(lat,lon,zoom){if(!Number.isInteger(zoom)||zoom<N||zoom>N)throw new Error(<q>);lat=Math.min(Math.max(lat,-N.N),N.N);\n const n=N**zoom,x=Math.min(Math.max(Math.floor((lon+N)/N*n),N),n-N),mercator=Math.log(Math.tan(Math.PI/N+lat*Math.PI/N/N)),y=Math.min(Math.max(Math.floor((N-mercator/Math.PI)/N*n),N),n-N);\n return{zoom,x,y,path:zoom+<q>+x+<q>+y}}\nconst query=o=>new URLSearchParams(o).toString();\nexport function mapsUrls(lat,lon){const point=coordinateText(lat,lon).split(<q>).join(<q>);\n return{google:<q>+query({api:<q>,query:point}),apple:<q>+query({ll:point,q:<q>}),\n  osm_preview:<q>+query({center:point,zoom:<q>,size:<q>,maptype:<q>,markers:point+<q>})}}\nconst radiusText=v=>Number.isInteger(v)?String(v):fixed(v,N);\nexport function areaTexts(a){const f=v=>fixed(v,N),lat=a.lat,lon=a.lon,radius=radiusText(a.radius_m),wraps=a.wraps?<q>:<q>,zoom=zoomForRadius(a.radius_m,lat),apple={ll:f(lat)+<q>+f(lon),q:<q>};\n if(a.apple_span&&a.lat_span>N&&a.lon_span>N)apple.spn=f(a.lat_span)+<q>+f(a.lon_span);\n return{center_radius:<q>+f(lat)+<q>+f(lon)+<q>+radius,\n  bounds:<q>+f(a.south)+<q>+f(a.west)+<q>+f(a.north)+<q>+f(a.east)+<q>+wraps,\n  bbox:<q>+f(a.west)+<q>+f(a.south)+<q>+f(a.east)+<q>+f(a.north)+<q>,\n  json:\<q>+f(lat)+\<q>+f(lon)+\<q>+radius+\<q>+f(a.south)+\<q>+f(a.west)+\<q>+f(a.north)+\<q>+f(a.east)+\<q>+wraps+\<q>,\n  google_circle:<q>+f(lat)+<q>+f(lon)+<q>+radius+<q>,\n  mapkit_circle:<q>+f(lat)+<q>+f(lon)+<q>+radius+<q>,\n  google_rectangle:<q>+f(a.south)+<q>+f(a.west)+<q>+f(a.north)+<q>+f(a.east)+<q>,\n  mapkit_region:<q>+f(lat)+<q>+f(lon)+<q>+f(a.lat_span)+<q>+f(a.lon_span)+<q>,\n  google_area_url:<q>+f(lat)+<q>+f(lon)+<q>+zoom+<q>,apple_area_url:<q>+query(apple)}}\nexport function bindCoordinates(root=document){return[...root.querySelectorAll(<q>)].map(box=>{\n const $=s=>box.querySelector(s),lat=$(<q>),lon=$(<q>),url=$(<q>),status=$(<q>),out=$(<q>),radius=$(<q>),zoom=$(<q>),preset=()=>box.querySelector(\<q>).value;\n const add=(label,text)=>{const dt=document.createElement(<q>),dd=document.createElement(<q>),pre=document.createElement(<q>);dt.textContent=label;pre.textContent=text;dd.append(pre);out.append(dt,dd)};\n const show=()=>{out.replaceChildren();try{const[la,lo]=parseCoordinate(lat.value,lon.value);status.textContent=<q>;\n   add(<q>,coordinateText(la,lo));add(<q>,dmsText(la,lo));const u=mapsUrls(la,lo);add(<q>,u.google);add(<q>,u.apple);add(<q>,u.osm_preview);\n   const r=preset()===<q>?Number(radius.value):Number(preset());try{const area=toleranceArea(la,lo,r),t=areaTexts(area);\n    add(<q>,t.center_radius);add(<q>,t.bounds);add(<q>,t.bbox);add(<q>,t.json);\n    add(<q>,t.google_circle);add(<q>,t.mapkit_circle);add(<q>,t.g